int) + (d[\"loan\"] == \"yes\").astype(int)\n","    f[\"age_extreme\"] = ((d[\"age\"] <= 25) | (d[\"age\"] >= 60)).astype(int)       # students / retirees respond more\n","    for c in CAT_BASE:\n","        f[c] = d[c]\n","    if use_month:\n","        f[\"month\"] = d[\"month\"]\n","    return f\n","\n","# Removed for leakage: duration, campaign (known only after contact), day (date of the outcome contact)\n","X = build_features(df, USE_MONTH)\n","CAT = [c for c in X.columns if X[c].dtype == \"object\"]\n","NUM = [c for c in X.columns if c not in CAT]\n","print(\"X:\", X.shape, \"| yes rate: %.4f\" % y.mean())\n","print(\"Numeric:\", NUM); print(\"Categorical:\", CAT)"]},{"cell_type":"code","execution_count":4,"id":"72f4fbf7","metadata":{"execution":{"iopub.execute_input":"2026-10-06T15:29:58.494973Z","iopub.status.busy":"2026-10-06T15:29:58.494705Z","iopub.status.idle":"2026-10-06T15:29:58.578717Z","shell.execute_reply":"2026-10-06T15:29:58.578035Z"},"papermill":{"duration":0.088621,"end_time":"2026-10-06T15:29:58.580157+00:00","exception":false,"start_time":"2026-10-06T15:29:58.491536+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>rows</th>\n","      <th>yes</th>\n","      <th>yes_rate</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>fit pool</th>\n","      <td>30742</td>\n","      <td>3596</td>\n","      <td>0.117</td>\n","    </tr>\n","    <tr>\n","      <th>validation (natural)</th>\n","      <td>5426</td>\n","      <td>635</td>\n","      <td>0.117</td>\n","    </tr>\n","    <tr>\n","      <th>