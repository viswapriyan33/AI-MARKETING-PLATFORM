","    # --------------------------------------------------------\n","    roc_auc = roc_auc_score(\n","        y_true,\n","        probabilities\n","    ) * 100\n","\n","    pr_auc = average_precision_score(\n","        y_true,\n","        probabilities\n","    ) * 100\n","\n","    # --------------------------------------------------------\n","    # Probability calibration\n","    # --------------------------------------------------------\n","    brier = brier_score_loss(\n","        y_true,\n","        np.clip(probabilities, 0, 1)\n","    ) * 100\n","\n","    # --------------------------------------------------------\n","    # Marketing metrics\n","    # --------------------------------------------------------\n","    lift_10, capture_10 = lift_at_k(\n","        y_true,\n","        probabilities,\n","        k=0.10\n","    )\n","\n","    # Convert marketing metrics to /100\n","    lift_10 = lift_10 * 100\n","    capture_10 = capture_10 * 100\n","\n","    # --------------------------------------------------------\n","    # Return results\n","    # --------------------------------------------------------\n","    return {\n","        \"Model\": model_name,\n","        \"Accuracy\": accuracy,\n","        \"Precision\": precision,\n","        \"Recall\": recall,\n","        \"F1\": f1,\n","        \"MCC\": mcc,\n","        \"ROC-AUC\": roc_auc,\n","        \"PR-AUC\": pr_auc,\n","        \"Brier\": brier,\n","        \"Lift@10%\": lift_10,\n","        \"Capture@10%\": capture_10\n","    }\n","\n","\n","# ============================================================\n","# CALCULATE RESULTS FOR ALL MODELS\n","# ============================================================\n","\n","results = []\n","\n","for model_name, predictor in predictors.items():\n","\n","    # Raw model probabilities\n","    p_raw = predictor(X_test)\n","\n","    # Convert balanced-training probabilities\n","    # back to natural population probabilities\n","    p_natural = to_natural(p_raw)\n","\n","    metrics = calculate_metrics(\n","        y_true=y_test,\n","        probabilities=p_natural,\n","        threshold=thr_f1,\n","        model_name=model_name\n","    )\n","\n","    results.append(metrics)\n","\n","\n","# ============================================================\n","# CREATE COMPARISON TABLE\n","# ============================================================\n","\n","model_results = pd.DataFrame(results)\n","\n","\n","# Sort by PR-AUC - highest first\n","model_results = model_results.sort_values(\n","    by=\"PR-AUC\",\n","    ascending=False\n",").reset_index(drop=True)\n","\n","\n","# Add ranking\n","model_results.insert(\n","    0,\n","    \"Rank\",\n","    range(1, len(model_results) + 1)\n",")\n","\n","\n","# ============================================================\n","# DISPLAY RESULTS OUT OF 100\n","# ============================================================\n","\n","display(\n","    model_results.style\n","    .format({\n","        \"Accuracy\": \"{:.2f}\",\n","        \"Precision\": \"{:.2f}\",\n","        \"Recall\": \"{:.2f}\",\n","        \"F1\": \"{:.2f}\",\n","        \"MCC\": \"{:.2f}\",\n","        \"ROC-AUC\": \"{:.2f}\",\n","        \"PR-AUC\": \"{:.2f}\",\n","        \"Brier\": \"{:.2f}\",\n","        \"Lift@10%\": \"{:.2f}\",\n","        \"Capture@10%\": \"{:.2f}\"\n","    })\n",")\n","\n","\n","# ============================================================\n","# BEST MODEL\n","# ============================================================\n","\n","best_model = model_results.iloc[0][\"Model\"]\n","\n","print(\"\\n========================================\")\n","print(\"BEST MODEL\")\n","print(\"========================================\")\n","\n","print(\"Model:\", best_model)\n","\n","print(\"\\nRanking Criterion: PR-AUC\")\n","print(\"Higher PR-AUC = Better\")\n","\n","print(\"\\nAll metrics are displayed out of 100.\")"]},{"cell_type":"code","execution_count":null,"id":"116dc770","metadata":{"papermill":{"duration":0.0