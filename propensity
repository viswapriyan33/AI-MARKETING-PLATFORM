oc[bal_idx]\n","PI_NAT = float(y_fit.mean())           # natural prior, used later for probability correction\n","\n","print(\"Balanced train:\", len(y_bal), \"|\", y_bal.value_counts().to_dict())\n","print(\"Leftover unseen 'no' rows:\", len(leftover_no_idx))\n","overlap = len(set(X_bal.index) & (set(X_val.index) | set(X_test.index)))\n","print(\"Train/val/test overlap:\", overlap)"]},{"cell_type":"code","execution_count":6,"id":"13620dad","metadata":{"execution":{"iopub.execute_input":"2026-10-06T15:29:58.619522Z","iopub.status.busy":"2026-10-06T15:29:58.619286Z","iopub.status.idle":"2026-10-06T15:29:58.628961Z","shell.execute_reply":"2026-10-06T15:29:58.628277Z"},"papermill":{"duration":0.014156,"end_time":"2026-10-06T15:29:58.630523+00:00","exception":false,"start_time":"2026-10-06T15:29:58.616367+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["helpers ready\n"]}],"source":["def lift_at_k(yt, p, k=0.10):\n","    yt, p = np.asarray(yt), np.asarray(p)\n","    m = max(1, int(np.ceil(len(yt) * k)))\n","    top = np.argsort(-p, kind=\"stable\")[:m]\n","    return yt[top].mean() / yt.mean(), yt[top].sum() / yt.sum()\n","\n","def evaluate(yt, p, thr=0.5, name=\"model\"):\n","    yt, p = np.asarray(yt), np.asarray(p)\n","    pred = (p >= thr).astype(int)\n","    l10, c10 = lift_at_k(yt, p, 0.10)\n","    return {\"model\": name, \"threshold\": round(float(thr), 3), \"n\": len(yt), \"prevalence\": yt.mean(),\n","            \"accuracy\": accuracy_score(yt, pred), \"balanced_acc\": balanced_accuracy_score(yt, pred),\n","            \"precision\": precision_score(yt, pred, zero_division=0), \"recall\": recall_score(yt, pred, zero_division=0),\n","            \"f1\": f1_score(yt, pred, zero_division=0), \"mcc\": matthews_corrcoef(yt, pred),\n","            \"roc_auc\": roc_auc_score(yt, p), \"pr_auc\": average_precision_score(yt, p),\n","            \"brier\": brier_score_loss(yt, np.clip(p, 0, 1)), \"lift@10%\": l10, \"capture@10%\": c10}\n","\n","def to_natural(p, pi_nat=None, pi_train=0.5):\n","    \"\"\"Undersampling shifts the prior; this rescales odds back to the natural class ratio.\"\"\"\n","    pi_nat = PI_NAT if pi_nat is None else pi_nat\n","    p = np.clip(np.asarray(p), 1e-6, 1 - 1e-6)\n","    odds = p / (1 - p) * (pi_nat / (1 - pi_nat)) / (pi_train / (1 - pi_train))\n","    return odds / (1 + odds)\n","print(\"helpers ready\")"]},{"cell_type":"code","execution_count":7,"id":"87d1b9bb","metadata":{"execution":{"iopub.execute_input":"2026-10-06T15:29:58.636472Z","iopub.status.busy":"2026-10-06T15:29:58.635973Z","iopub.status.idle":"2026-10-06T15:32:17.091694Z","shell.execute_reply":"2026-10-06T15:32:17.090907Z"},"papermill":{"duration":138.463212,"end_time":"2026-10-06T15:32:17.095782+00:00","exception":false,"start_time":"2026-10-06T15:29:58.63257+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["done: LogReg\n","done: HGB\n","done: RandomForest\n","done: ExtraTrees\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>cv_roc_auc</th>\n","      <th>best_params</th>\n","    </tr>\n","    <tr>\n","      <th>model</th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>LogReg</th>\n","      <td>0.740</td>\n","      <td>{'clf__C': 0.03}</td>\n","    </tr>\n","    <tr>\n","      <th>HGB</th>\n","      <td>0.750</td>\n","      <td>{'clf__min_samples_leaf': 80, 'clf__max_iter': 300, 'clf__max_depth': 3, 'clf__learning_rate': 0.02, 'clf__l2_regula...</td>\n","    </tr>\n","    <tr>\n","      <th>RandomForest</th>\n","      <td>0.749</td>\n","      <td>{'clf__n_estimators': 300, 'clf__min_samples_leaf': 20, 'clf__max_features': 0.3, 'clf__max_depth': 8}</td>\n","    </tr>\n","    <tr>\n","      <th>ExtraTrees</th>\n","      <td>0.744</td>\n","      <td>{'clf__n_estimators': 500, 'clf__min_samples_leaf': 20, 'clf__max_features': 'sqrt', 'clf__max_depth': None}</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["              cv_roc_auc                                                                                                              best_params\n","model                                                                                                                                            \n","LogReg             0.740                                                                                                         {'clf__C': 0.03}\n","HGB                0.750  {'clf__min_samples_leaf': 80, 'clf__max_iter': 300, 'clf__max_depth': 3, 'clf__learning_rate': 0.02, 'clf__l2_regula...\n","RandomForest       0.749                   {'clf__n_estimators': 300, 'clf__min_samples_leaf': 20, 'clf__max_features': 0.3, 'clf__max_depth': 8}\n","ExtraTrees         0.744             {'clf__n_estimators': 500, 'clf__min_samples_leaf': 20, 'clf__max_features': 'sqrt', 'clf__max_depth': None}"]},"metadata":{},"output_type":"display_data"}],"source":["skf = StratifiedKFold(5, shuffle=True, random_state=RANDOM_STATE)\n","\n","def make_pre(scale, num=None, cat=None):\n","    num = NUM if num is None else num; cat = CAT if cat is None else cat\n","    steps = [(\"imp\", SimpleImputer(strategy=\"median\", keep_empty_features=True))]\n","    if scale: steps.append((\"sc\", StandardScaler()))\n","    return ColumnTransformer([(\"num\", Pipeline(steps), num),\n","                              (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat)])\n","\n","specs = {\n","  \"LogReg\": (Pipeline([(\"prep\", make_p