execute_input":"2026-10-03T04:09:40.972039Z","iopub.status.busy":"2026-10-03T04:09:40.971144Z","iopub.status.idle":"2026-10-03T04:09:48.217997Z","shell.execute_reply":"2026-10-03T04:09:48.216545Z"},"papermill":{"duration":7.266003,"end_time":"2026-10-03T04:09:48.220034+00:00","exception":false,"start_time":"2026-10-03T04:09:40.954031+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","Logistic Regression  accuracy = 0.246\n","              precision    recall  f1-score   support\n","\n","        high       0.26      0.22      0.24      1500\n","         low       0.25      0.27      0.26      1500\n","      medium       0.24      0.22      0.23      1500\n","       viral       0.24      0.27      0.25      1500\n","\n","    accuracy                           0.25      6000\n","   macro avg       0.25      0.25      0.25      6000\n","weighted avg       0.25      0.25      0.25      6000\n","\n","\n","Random Forest  accuracy = 0.234\n","              precision    recall  f1-score   support\n","\n","        high       0.24      0.24      0.24      1500\n","         low       0.23      0.23      0.23      1500\n","      medium       0.22      0.21      0.22      1500\n","       viral       0.24      0.25      0.25      1500\n","\n","    accuracy                           0.23      6000\n","   macro avg       0.23      0.23      0.23      6000\n","weighted avg       0.23      0.23      0.23      6000\n","\n","Chance level (4 balanced classes) ≈ 0.25\n","Conclusion: pre-publication features carry almost no signal for the bucket label, so Dataset 3 is used for post-performance analytics, not prediction.\n"]}],"source":["\n","\n","\n","from sklearn.model_selection import train_test_split\n","from sklearn.compose import ColumnTransformer\n","from sklearn.preprocessing import OneHotEncoder, StandardScaler\n","from sklearn.pipeline import Pipeline\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.ensemble import RandomForestClassifier\n","from sklearn.metrics import accuracy_score, classification_report\n","\n","X = df[PRE_FEATURES]; y = df[TARGET].astype(str)\n","cat = [\"account_type\",\"media_type\",\"content_category\",\"traffic_source\",\"day_of_week\"]\n","num = [c for c in PRE_FEATURES if c not in cat]\n","prep = ColumnTransformer([(\"cat\", OneHotEncoder(handle_unknown=\"ignore\"), cat),\n","                          (\"num\", StandardScaler(), num)])\n","\n","X_tr, X_te, y_tr, y_te = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)\n","\n","models = {\"Logistic Regression\": LogisticRegression(max_iter=1000),\n","          \"Random Forest\": RandomForestClassifier(n_estimators=300, random_state=42, n_jobs=-1)}\n","results = {}\n","for name, m in models.items():\n","    pipe = Pipeline([(\"prep\", prep), (\"model\", m)]).fit(X_tr, y_tr)\n","    pred = pipe.predict(X_te)\n","    results[name] = accuracy_score(y_te, pred)\n","    print(f\"\\n{name}  accuracy = {results[name]:.3f}\")\n","    print(classification_report(y_te, pred))\n","\n","print(\"Chance level (4 balanced classes) ≈ 0.25\")\n","print(\"Conclusion: pre-publication features carry almost no signal for the bucket label,\",\n","      \"so Dataset 3 is used for post-performance analytics, not prediction.\")"]},{"cell_type":"code","execution_count":15,"id":"f7d0a8f3","metadata":{"execution":{"iopub.execute_input":"2026-10-03T04:09:48.253269Z","iopub.status.busy":"2026-10-03T04:09:48.252626Z","iopub.status.idle":"2026-10-03T04:09:48.383835Z","shell.execute_reply":"2026-10-03T04:09:48.382975Z"},"papermill":{"duration":0.150808,"end_time":"2026-10-03T04:09:48.386119+00:00","exception":false,"start_time":"2026-10-03T04:09:48.235311+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import json, joblib, os\n","\n","PCT_POINTS = np.arange(0, 101)\n","\n","def to_pct(x):\n","    \"\"\"Accepts 0.124 or 12.4 and always returns percent.\"\"\"\n","    return x * 100 if x < 1 else x\n","\n","def build_reference(df):\n","    ref = {\"overall_er_pct_quantiles\": np.percentile(df[\"engagement_rate_pct\"], PCT_POINTS).tolist(),\n","           \"peers\": {}, \"best_hours\": {}}\n","    for (m, c), g in df.groupby([\"media_type\", \"content_category\"]):\n","        ref[\"peers\"][f\"{m}|{c}\"] = {\n","            \"n\": int(len(g)),\n","            \"er_pct_quantiles\": np.percentile(g[\"engagement_rate_pct\"], PCT_POINTS).tolist(),\n","            **{f\"{col}_q75\": float(g[col].quantile(.75)) for col in [\"shares\", \"saves\", \"followers_gained\", \"reach\"]},\n","        }\n","    for c, g in df.groupby(\"content_category\"):\n","        top = g.groupby(\"post_hour\")[\"engagement_rate_pct\"].mean().nlargest(3).index\n","        ref[\"best_hours\"][c] = [int(h) for h in top]\n","    return ref\n","\n","REFERENCE = build_reference(df)\n","\n","def pct_rank(quantiles, value):\n","    return float(np.interp(value, quantiles, PCT_POINTS))\n","\n","def analyze_post(post: dict, label: str = None, reference: dict = None):\n","    ref = reference or REFERENCE\n","    er = to_pct(post[\"engagement_rate\"])\n","    peers = ref[\"peers\"][f\"{post['media_type']}|{post['content_category']}\"]\n","\n","    p_overall = pct_rank(ref[\"overall_er_pct_quantiles\"], er)\n","    p_peers = pct_rank(peers[\"er_pct_quantiles\"], er)\n","\n","    if label is None:   # fallback when the dataset label is not supplied\n","        label = (\"low\" if p_overall < 25 else \"medium\" if p_overall < 50\n","                 else \"high\" if p_overall < 75 else \"viral\")\n","\n","    insights, recs = [], []\n","    if post[\"shares\"] > peers[\"shares_q75\"]:\n","        insights.append(\"High sharing activity vs similar posts\")\n","        recs.append(\"Create variations of this post to build on share momentum\")\n","    if post[\"saves\"] > peers[\"saves_q75\"]:\n","        insights.append(\"Strong saves: audience sees lasting value\")\n","        recs.append(\"Produce more educational / reference-style content\")\n","    if post[\"followers_gained\"] > peers[\"followers_gained_q75\"]:\n","        insights.append(\"Strong follower growth\")\n","    if post[\"reach\"] > peers[\"reach_q75\"]:\n","        insights.append(\"Reach above peer benchmark\")\n","    if post.get(\"has_call_to_action\", 0) == 1:\n","        insights.append(\"CTA used\")\n","        recs.append(\"Maintain CTA usage and test wording variants\")\n","    if p_peers >= 75:\n","        insights.append(f\"{post['media_type'].title()} + {post['content_category']} outperformed peers\")\n","        recs.append(f\"Test more {post['content_category']} topics in {post['media_type']} format\")\n","    if p_peers < 25:\n","        insights.append(\"Engagement below peer benchmark\")\n","        recs.append(\"Test a different format, topic, or posting window\")\n","    recs.append(f\"Candidate posting hours for this category: {ref['best_hours'][post['content_category']]}\")\n","\n","    return {\n","        \"performance_level\": label.upper(),\n","        \"engagement_rate_pct\": round(er, 2),\n","        \"reach\": post[\"reach\"], \"impressions\": post[\"impressions\"],\n","        \"breakdown\": {k: post[k] for k in [\"likes\", \"comments\", \"shares\", \"saves\"]},\n","        \"followers_gained\": post[\"followers_gained\"],\n","        \"engagement_percentile_overall\": round(p_overall, 1),\n","        \"engagement_percentile_vs_peers\": round(p_peers, 1),\n","        \"insights\": insights, \"recommendations\": recs,\n","    }"]},{"cell_type":"code","execution_count":16,"id":"f59a32fb","metadata":{"execution":{"iopub.execute_input":"2026-10-03T04:09:48.418017Z","iopub.status.busy":"2026-10-03T04:09:48.417662Z","iopub.status.idle":"2026-10-03T04:09:48.424197Z","shell.execute_reply":"2026-10-03T04:09:48.423022Z"},"papermill":{"duration":0.025432,"end_time":"2026-10-03T04:09:48.426596+00:00","exception":false,"start_time":"2026-10-03T04:09:48.401164+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["{\n","  \"performance_level\": \"VIRAL\",\n","  \"engagement_rate_pct\": 12.4,\n","  \"reach\": 28000,\n","  \"impressions\": 35000,\n","  \"breakdown\": {\n","    \"likes\": 3200,\n","    \"comments\": 180,\n","    \"shares\": 450,\n","    \"saves\": 620\n","  },\n","  \"followers_gained\": 380,\n","  \"engagement_percentile_overall\": 99.0,\n","  \"engagement_percentile_vs_peers\": 98.6,\n","  \"insights\": [\n","    \"High sharing activity vs similar posts\",\n","    \"Strong saves: audience sees lasting value\",\n","    \"Reach above peer benchmark\",\n","    \"CTA used\",\n","    \"Reel + Fitness outperformed peers\"\n","  ],\n","  \"recommendations\": [\n","    \"Create variations of this post to build on share momentum\",\n","    \"Produce more educational / reference-style content\",\n","    \"Maintain CTA usage and test wording variants\",\n","    \"Test more Fitness topics in reel format\",\n","    \"Candidate posting hours for this category: [2, 8, 16]\"\n","  ]\n","}\n"]}],"source":["example = {\n","    \"media_type\":\"reel\",\"content_category\":\"Fitness\",\"traffic_source\":\"Reels Feed\",\n","    \"has_call_to_action\":1,\"post_hour\":18,\n","    \"likes\":3200,\"comments\":180,\"shares\":450,\"saves\":620,\n","    \"reach\":28000,\"impressions\":35000,\n","    \"engagement_rate\":0.124,   # fraction, same scale as the dataset\n","    \"followers_gained\":380,\n","}\n","import json\n","print(json.dumps(analyze_post(example), indent=2))"]},{"cell_type":"code","execution_count":17,"id":"f1fe9d9e","metadata":{"execution":{"iopub.execute_input":"2026-10-03T04:09:48.459135Z","iopub.status.busy":"2026-10-03T04:09:48.458769Z","iopub.status.idle":"2026-10-03T04:09:48.473382Z","shell.execute_reply":"2026-10-03T04:09:48.471994Z"},"papermill":{"duration":0.033745,"end_time":"2026-10-03T04:09:48.475531+00:00","exception":false,"start_time":"2026-10-03T04:09:48.441786+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Next campaign: lean on reel + Fitness content around 18:00.\n"]}],"source":["history = []   # in the real platform this would be a database table\n","\n","def store_result(post_id, post, label=None):\n","    res = analyze_post(post, label)\n","    history.append({\"post_id\": post_id, **{k: post[k] for k in\n","                    [\"media_type\",\"content_category\",\"post_hour\"]}, **res})\n","    return res\n","\n","store_result(\"POST_101\", example)\n","\n","def next_campaign_hint(history_df):\n","    top = history_df[history_df[\"engagement_percentile_vs_peers\"] >= 75]\n","    if top.empty: return \"No strong performers yet; keep testing formats.\"\n","    best = top.groupby([\"media_type\",\"content_category\"]).size().idxmax()\n","    hour = int(top[\"post_hour\"].mode()[0])\n","    return f\"Next campaign: lean on {best[0]} + {best[1]} content around {hour}:00.\"\n","\n","print(next_campaign_hint(pd.DataFrame(history)))"]},{"cell_type":"markdown","id":"d242607e","metadata":{"execution":{"iopub.execute_input":"2026-10-02T07:03:19.50901Z","iopub.status.busy":"2026-10-02T07:03:19.508672Z","iopub.status.idle":"2026-10-02T07:03:19.516843Z","shell.execute_reply":"2026-10-02T07:03:19.515739Z","shell.execute_reply.started":"2026-10-02T07:03:19.508974Z"},"papermill":{"duration":0.015745,"end_time":"2026-10-03T04:09:48.507101+00:00","exception":false,"start_time":"2026-10-03T04:09:48.491356+00:00","status":"completed"},"tags":[]},"source":["## Key Findings\n","- Dataset: 29,999 Instagram posts, no missing values or duplicates; engagement_rate is stored as a fraction.\n","- Performance buckets are close to balanced across low / medium / high / viral.\n","- Pre-publication features (10 columns) showed near-identical distributions across buckets;\n","  Logistic Regression and Random Forest scored about 25%, i.e. chance level.\n","- Therefore Dataset 3 is used for post-performance an