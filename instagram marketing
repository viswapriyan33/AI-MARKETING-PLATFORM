n(idea.split()) < 3: problems.append(\"content_idea missing or too short\")\n\n    text_all = (cap + \" \" + cta).lower()\n    for pat in CLAIM_PATTERNS:                         # claims the brief did not allow -> warn the human\n        m = re.search(pat, text_all)\n        if m and not any(a.lower() in text_all for a in allowed_claims):\n            warnings_.append(f\"unsupported claim? '{m.group(0)}' - not in the brief, needs human check\")\n    if library_df is not None and cap:                 # is the caption almost a copy of a library caption?\n        j = float(library_df[\"caption_clean\"].map(lambda x: jaccard(cap, x)).max())\n        if j > 0.7: warnings_.append(f\"caption is {j:.0%} similar to a library caption (possible copy)\")\n    return {\"passed\": len(problems) == 0, \"problems\": problems, \"warnings\": warnings_}\n\ndef parse_llm_json(text):\n    \"\"\"LLMs sometimes wrap JSON in ```json fences or add a sentence around it. Extract and parse the JSON object.\"\"\"\n    t = re.sub(r\"^```(?:json)?\\s*|\\s*```$\", \"\", text.strip())\n    start, end = t.find(\"{\"), t.rfind(\"}\")\n    if start == -1 or end == -1: raise ValueError(\"no JSON object found in the LLM response\")\n    return json.loads(t[start:end + 1])\nprint(\"Validators ready: validate_hashtags, validate_content, parse_llm_json\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:35:04.174308Z","iopub.execute_input":"2026-10-04T03:35:04.174581Z","iopub.status.idle":"2026-10-04T03:35:04.20986Z","shell.execute_reply.started":"2026-10-04T03:35:04.174559Z","shell.execute_reply":"2026-10-04T03:35:04.20879Z"}},"outputs":[{"name":"stdout","text":"Validators ready: validate_hashtags, validate_content, parse_llm_json\n","output_type":"stream"}],"execution_count":143},{"cell_type":"code","source":"# =====================================================================================\n# CELL 14B - TEST THE HASHTAG VALIDATOR\n# PURPOSE : Prove the validator accepts a