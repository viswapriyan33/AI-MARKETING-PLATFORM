es are lowercase\n        if value in VOCAB[lib_col]:                                  # only use values the dataset really contains\n            query[lib_col] = value\n    return query\n\nquery_used = brief_to_query(marketing_brief)\nprint(\"Query sent to the retriever:\"); print(json.dumps(query_used, indent=2))\nretrieved_examples = retrieve_examples(query_used, k=3)\nprint(\"\\nRetrieved examples:\")\ndisplay(retrieved_examples[[\"score\", \"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\", \"hashtags_clean\", \"cta_clean\"]])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:35:04.073856Z","iopub.execute_input":"2026-10-04T03:35:04.074164Z","iopub.status.idle":"2026-10-04T03:35:04.116092Z","shell.execute_reply.started":"2026-10-04T03:35:04.07414Z","shell.execute_reply":"2026-10-04T03:35:04.115055Z"}},"outputs":[{"name":"stdout","text":"Query sent to the retriever:\n{\n  \"business_text\": \"Civil Works Company Bathroom Renovation Homeowners Generate Enquiries Chennai\",\n  \"brand_voice\": \"professional and trustworthy\",\n  \"occasion\": \"before and after\",\n  \"format\": \"feed post\",\n  \"brand_palette\": \"muted neutrals\"\n}\n\nRetrieved examples:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"     score     business_type                   brand_voice          occasion  \\\n252    0.7          wine bar  professional and trustworthy  before and after   \n279    0.7  co-working space  professional and trustworthy  before and after   \n595    0.7      tech startup  professional and trustworthy  before and after   \n\n        format                                      caption_clean  \\\n252  feed post            Transform your night with our wines! 🍷🎉   \n279  feed post  Transform your workspace with us. Before & aft...   \n595  feed post            Before and after: Our tech revolution 🚀   \n\n                                hashtags_clean         cta_clean  \n252    