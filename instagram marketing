t\ndf[\"brief_text\"] = (df[\"business_type\"] + \", \" + df[\"brand_voice\"] + \", \" + df[\"occasion\"] + \", \"\n                    + df[\"format\"] + \", \" + df[\"brand_palette\"])\ndf[\"doc_text\"] = (df[\"business_type\"] + \" \" + df[\"occasion\"] + \" \" + df[\"hashtags_clean\"] + \" \"\n                  + df[\"caption_clean\"] + \" \" + df[\"image_prompt\"].astype(str)).str.lower()\n\nprint(\"Rows total                       :\", len(df))\nprint(\"Rows passing quality_ok          :\", int(df[\"quality_ok\"].sum()))\nprint(\"Rows excluded from the library   :\", int((~df['quality_ok']).sum()))\nprint(\"Captions that still contain '#'  :\", int(df['caption_clean'].str.contains('#').sum()))\nprint(\"Hashtag lists with '#' symbol    :\", int(df['hashtags_clean'].str.contains('#').sum()))\n\nlibrary = df[df[\"quality_ok\"]].reset_index(drop=True)    # the clean example library\nprint(\"Library size:\", len(library))\nlibrary[[\"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\", \"hashtags_clean\", \"cta_clean\"]].head(5)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:34:57.433593Z","iopub.execute_input":"2026-10-04T03:34:57.433951Z","iopub.status.idle":"2026-10-04T03:34:57.510267Z","shell.execute_reply.started":"2026-10-04T03:34:57.433917Z","shell.execute_reply":"2026-10-04T03:34:57.509263Z"}},"outputs":[{"name":"stdout","text":"Rows total                       : 1447\nRows passing quality_ok          : 1438\nRows excluded from the library   : 9\nCaptions that still contain '#'  : 0\nHashtag lists with '#' symbol    : 0\nLibrary size: 1438\n","output_type":"stream"},{"execution_count":134,"output_type":"execute_result","data":{"text/plain":"        business_type                   brand_voice          occasion  \\\n0            wine bar               edgy and modern   loyalty rewards   \n1    co-working space             playful and witty    flash giveaway   \n2    vegan restaurant            bold and co