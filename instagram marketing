\n","Name: count, dtype: int64\n","\n","Platform values: ['Instagram'] (only Instagram: no Facebook/LinkedIn examples)\n","\n","Brief combinations possible : 9,600\n","Brief combinations present  : 1,338  (13.9% of all possible)\n","Combinations with exactly 1 example: 92.7%\n"]}],"source":["# =====================================================================================\n","# CELL 5 - ANALYSE THE CATEGORICAL FIELDS (the \"brief\" columns)\n","# PURPOSE : Measure diversity: how many business types, voices, occasions, formats exist and how\n","#           evenly they are spread.\n","# WHY     : A retrieval library is only useful for briefs it has examples for. Coverage matters.\n","# KEY FINDING: Only ~14% of possible brief combinations exist and ~93% of those have one example,\n","#           so a model cannot \"learn\" each combination; we can only search for the closest ones.\n","# =====================================================================================\n","for col in CAT_COLS:\n","    vc = df[col].value_counts()\n","    print(f\"{col:14s} unique = {df[col].nunique():3d} | smallest group = {vc.min():4d} | largest group = {vc.max():4d}\")\n","\n","# Bar charts of the four main category columns\n","fig, axes = plt.subplots(2, 2, figsize=(15, 9))\n","for ax, col in zip(axes.ravel(), [\"business_type\", \"brand_voice\", \"occasion\", \"brand_palette\"]):\n","    order = df[col].value_counts().index                      # most common first\n","    sns.countplot(y=df[col], order=order, ax=ax, color=\"steelblue\")\n","    ax.set_title(f\"Posts per {col}\")\n","plt.tight_layout(); plt.show()\n","\n","print(\"\\nFormat split:\"); print(df[\"format\"].value_counts())\n","print(\"\\nPlatform values:\", df[\"platform\"].unique(), \"(only Instagram: no Facebook/LinkedIn examples)\")\n","\n","# Coverage of the full grid of possible briefs\n","combo = df.groupby([\"business_type\", \"brand_voice\", \"occasion\", \"format\"]).size()   # examples per combination\n","possible = (df[\"business_type\"].nunique() * df[\"brand_voice\"].nunique()\n","            * df[\"occasion\"].nunique() * df[\"format\"].nunique())                     # 30 x 8 x 20 x 2\n","print(f\"\\nBrief combinations possible : {possible:,}\")\n","print(f\"Brief combinations present  : {len(combo):,}  ({len(combo)/possible:.1%} of all possible)\")\n","print(f\"Combinations with exactly 1 example: {(combo == 1).mean():.1%}\")"]},{"cell_type":"code","execution_count":7,"id":"67e6a629","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:48:59.152808Z","iopub.status.busy":"2026-10-07T04:48:59.152158Z","iopub.status.idle":"2026-10-07T04:48:59.706324Z","shell.execute_reply":"2026-10-07T04:48:59.705473Z"},"papermill":{"duration":0.56461,"end_time":"2026-10-07T04:48:59.708366+00:00","exception":false,"start_time":"2026-10-07T04:48:59.143756+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["--- Caption length (words) ---\n","count    1447.00\n","mean        9.79\n","std         3.39\n","min         3.00\n","25%         7.00\n","50%         9.00\n","75%        12.00\n","max        25.00\n","Name: _caption_words, dtype: float64\n","\n","--- Hashtags per post ---\n","count    1447.00\n","mean        4.02\n","std         0.23\n","min         2.00\n","25%         4.00\n","50%         4.00\n","75%         4.00\n","max         8.00\n","Name: _hashtag_count, dtype: float64\n","\n","--- CTA length (words) ---\n","count    1447.00\n","mean        2.50\n","std         0.67\n","min         1.00\n","25%         2.00\n","50%         2.00\n","75%         3.00\n","max         6.00\n","Name: _cta_words, dtype: float64\n","\n","=== Formatting problems found in the raw text ===\n","Captions containing '#' (hashtags leaked into caption): 322\n","Hashtag cells that include the '#' symbol            : 653 of 1447\n","Captions shorter than 4 words                        : 5\n","Captions containing emoji / non-ASCII                : 86.7%\n","\n","CTA unique as written: 665 | after ignoring case/punctuation: 489\n","\n","Top 10 CTAs (normalised):\n","cta\n","shop now          143\n","book now           94\n","join us            61\n","learn more         53\n","enter now          48\n","visit us           47\n","explore now        38\n","order now          36\n","see more           21\n","visit us today     20\n","Name: count, dtype: int64\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1600x400 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# =====================================================================================\n","# CELL 6 - ANALYSE THE TEXT FIELDS (caption, hashtags, CTA)\n","# PURPOSE : Measure text length and find formatting problems in the raw data.\n","# WHY     : Examples we show to an LLM must be clean. Problems found here are fixed in Cell 8.\n","# KEY FINDINGS: captions are very short (about 10 words); 322 captions contain leaked hashtags;\n","#           hashtags are written inconsistently; CTAs repeat with small spelling differences.\n","# =====================================================================================\n","def words(s):                         # count words in a piece of text\n","    return len(str(s).split())\n","\n","df[\"_caption_words\"] = df[\"caption\"].map(words)\n","df[\"_hashtag_count\"] = df[\"hashtags\"].fillna(\"\").str.split().str.len()\n","df[\"_cta_words\"]     = df[\"cta\"].map(words)\n","\n","print(\"--- Caption length (words) ---\"); print(df[\"_caption_words\"].describe().round(2))\n","print(\"\\n--- Hashtags per post ---\");     print(df[\"_hashtag_count\"].describe().round(2))\n","print(\"\\n--- CTA length (words) ---\");    print(df[\"_cta_words\"].describe().round(2))\n","\n","print(\"\\n=== Formatting problems found in the raw text ===\")\n","print(\"Captions containing '#' (hashtags leaked into caption):\", int(df[\"caption\"].str.contains(\"#\").sum()))\n","print(\"Hashtag cells that include the '#' symbol            :\", int(df[\"hashtags\"].str.contains(\"#\").sum()), \"of\", len(df))\n","print(\"Captions shorter than 4 words                        :\", int((df[\"_caption_words\"] < 4).sum()))\n","emoji_share = df[\"caption\"].str.contains(r\"[^\\x00-\\x7F]\").mean()     # non-ASCII characters = mostly emoji\n","print(\"Captions containing emoji / non-ASCII                :\", f\"{emoji_share:.1%}\")\n","\n","# CTAs: \"Book now\" and \"Book Now!\" are the same CTA, so compare after lowercasing and removing punctuation\n","cta_key = df[\"cta\"].str.lower().str.replace(r\"[^\\w\\s]\", \"\", regex=True).str.strip()\n","print(f\"\\nCTA unique as written: {df['cta'].nunique()} | after ignoring case/punctuation: {cta_key.nunique()}\")\n","print(\"\\nTop 10 CTAs (normalised):\"); print(cta_key.value_counts().head(10))\n","\n","fig, axes = plt.subplots(1, 3, figsize=(16, 4))\n","sns.histplot(df[\"_caption_words\"], bins=20, ax=axes[0], color=\"teal\");   axes[0].set_title(\"Caption length (words)\")\n","sns.histplot(df[\"_hashtag_count\"], bins=range(0, 10), ax=axes[1], color=\"orange\"); axes[1].set_title(\"Hashtags per post\")\n","sns.histplot(df[\"_cta_words\"], bins=range(0, 8), ax=axes[2], color=\"purple\");      axes[2].set_title(\"CTA length (words)\")\n","plt.tight_layout(); plt.show()"]},{"cell_type":"code","execution_count":8,"id":"99543928","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:48:59.727813Z","iopub.status.busy":"2026-10-07T04:48:59.727043Z","iopub.status.idle":"2026-10-07T04:48:59.785214Z","shell.execute_reply":"2026-10-07T04:48:59.784029Z"},"papermill":{"duration":0.070429,"end_time":"2026-10-07T04:48:59.787193+00:00","exception":false,"start_time":"2026-10-07T04:48:59.716764+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Rows flagged has_image            : 1000\n","Image files actually found on disk: 0\n","-> No image files are available in this notebook (the CSV only stores a path from the creator's environment).\n","   This does not affect the text-based method; image prompts are still used as text.\n","\n","--- image_prompt length (words) ---\n","count    1447.00\n","mean       13.06\n","std         2.95\n","min         1.00\n","25%        11.00\n","50%        13.00\n","75%        15.00\n","max        24.00\n","Name: _prompt_words, dtype: float64\n","\n","Share of image prompts that mention their palette's key words, by palette:\n","brand_palette\n","muted neutrals                0.25\n","forest greens                 0.39\n","ocean blues and teals         0.53\n","warm earthy tones             0.63\n","gold and cream luxury         0.74\n","monochrome black and white    0.77\n","pastel and soft               0.78\n","vibrant and colorful          0.87\n","Name: _palette_in_prompt, dtype: float64\n"]}],"source":["# =====================================================================================\n","# CELL 7 - ANALYSE THE IMAGE-RELATED FIELDS\n","# PURPOSE : Check whether image files are actually available, and how good the image prompts are.\n","# WHY     : The CSV only stores a text path such as /content/social_data/images/img_00000.png from the\n","#           creator's computer. The pictures themselves are a separate folder. If the files are not\n","#           attached to this notebook, this notebook can only use the image PROMPTS (text).\n","# KEY FINDING: image prompts often ignore the palette (e.g. \"muted neutrals\" appears in only ~25% of its prompts).\n","# =====================================================================================\n","IMAGE_DIR_GUESS = glob.glob(\"/kaggle/input/**/images\", recursive=True)   # any \"images\" folder among Kaggle inputs\n","\n","def find_image_file(image_path):\n","    \"\"\"Return a real file path for a given image_path, or None if the picture is not available.\"\"\"\n","    if not isinstance(image_path, str):\n","        return None\n","    if os.path.exists(image_path):                       # the stored path works as-is\n","        return image_path\n","    base = os.path.basename(image_path)                  # otherwise try just the file name in known folders\n","    for folder in IMAGE_DIR_GUESS:\n","        cand = os.path.join(folder, base)\n","        if os.path.exists(cand):\n","            return cand\n","    return None\n","\n","with_img = df[df[\"has_image\"]]\n","found = with_img[\"image_path\"].map(find_image_file)\n","print(\"Rows flagged has_image            :\", len(with_img))\n","print(\"Image files actually found on disk:\", int(found.notna().sum()))\n","\n","if found.notna().sum() == 0:\n","    print(\"-> No image files are available in this notebook (the CSV only stores a path from the creator's environment).\")\n","    print(\"   This does not affect the text-based method; image prompts are still used as text.\")\n","else:\n","    from PIL import Image                                # show 3 random images with their business and occasion\n","    sample = with_img[found.notna()].sample(3, random_state=SEED)\n","    fig, axes = plt.subplots(1, 3, figsize=(14, 5))\n","    for ax, (_, r) in zip(axes, sample.iterrows()):\n","        ax.imshow(Image.open(find_image_file(r[\"image_path\"]))); ax.axis(\"off\")\n","        ax.set_title(f\"{r['business_type']} | {r['occasion']}\", fontsize=9)\n","    plt.show()\n","\n","df[\"_prompt_words\"] = df[\"image_prompt\"].map(lambda s: len(str(s).split()))\n","print(\"\\n--- image_prompt length (words) ---\"); print(df[\"_prompt_words\"].describe().round(2))\n","\n","# Does the image prompt actually mention the colours of the palette it was generated for?\n","STOP = {\"and\", \"the\", \"with\", \"soft\", \"tones\", \"colors\", \"color\"}      # filler words to ignore\n","def palette_hit(row):\n","    keys = [w for w in re.findall(r\"[a-z]+\", row[\"brand_palette\"].lower()) if len(w) > 3 and w not in STOP]\n","    return any(k in row[\"image_prompt\"].lower() for k in keys)\n","df[\"_palette_in_prompt\"] = df.apply(palette_hit, axis=1)\n","print(\"\\nShare of image prompts that mention their palette's key words, by palette:\")\n","print(df.groupby(\"brand_palette\")[\"_palette_in_prompt\"].mean().round(2).sort_values())"]},{"cell_type":"code","execution_count":9,"id":"5877f1ee","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:48:59.807247Z","iopub.status.busy":"2026-10-07T04:48:59.806641Z","iopub.status.idle":"2026-10-07T04:48:59.871914Z","shell.execute_reply":"2026-10-07T04:48:59.871046Z"},"papermill":{"duration":0.077789,"end_time":"2026-10-07T04:48:59.873959+00:00","exception":false,"start_time":"2026-10-07T04:48:59.79617+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Rows total                       : 1447\n","Rows passing quality_ok          : 1438\n","Rows excluded from the library   : 9\n","Captions that still contain '#'  : 0\n","Hashtag lists with '#' symbol    : 0\n","Library size: 1438\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>business_type</th>\n","      <th>brand_voice</th>\n","      <th>occasion</th>\n","      <th>format</th>\n","      <th>caption_clean</th>\n","      <th>hashtags_clean</th>\n","      <th>cta_clean</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>wine bar</td>\n","      <td>edgy and modern</td>\n","      <td>loyalty rewards</td>\n","      <td>story</td>\n","      <td>Celebrate your loyalty with a surprise! 🥂✨</td>\n","      <td>loyaltylovers drinkup winebarreward tasteexplorer</td>\n","      <td>Check your DMs!</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>co-working space</td>\n","      <td>playful and witty</td>\n","      <td>flash giveaway</td>\n","      <td>story</td>\n","      <td>Win big with just one click! 🎉!</td>\n","      <td>flashgiveaway co_work winprize workplay</td>\n","      <td>Enter now!</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>vegan restaurant</td>\n","      <td>bold and confident</td>\n","      <td>tips and how-to</td>\n","      <td>feed post</td>\n","      <td>How to cook a vegan feast! 🌿✨</td>\n","      <td>veganveggie plantbased vegantips veganjoy</td>\n","      <td>Like if you're vegan!</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>bookstore</td>\n","      <td>edgy and modern</td>\n","      <td>before and after</td>\n","      <td>story</td>\n","      <td>Before and after: your favorite book! 📚✨</td>\n","      <td>beforeandafter bookish readmore bookaddict</td>\n","      <td>Tell us which one!</td>\n","    </tr>\n","    <tr>\n","      <th>4</th>\n","      <td>photography studio</td>\n","      <td>professional and trustworthy</td>\n","      <td>loyalty rewards</td>\n","      <td>feed post</td>\n","      <td>Thank you for your trust! 📸✨</td>\n","      <td>photographylove trustworthy photostudio photojoy</td>\n","      <td>Share your photos!</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["        business_type                   brand_voice          occasion  \\\n","0            wine bar               edgy and modern   loyalty rewards   \n","1    co-working space             playful and witty    flash giveaway   \n","2    vegan restaurant            bold and confident   tips and how-to   \n","3           bookstore               edgy and modern  before and after   \n","4  photography studio  professional and trustworthy   loyalty rewards   \n","\n","      format                               caption_clean  \\\n","0      story  Celebrate your loyalty with a surprise! 🥂✨   \n","1      story             Win big with just one click! 🎉!   \n","2  feed post               How to cook a vegan feast! 🌿✨   \n","3      story    Before and after: your favorite book! 📚✨   \n","4  feed post                Thank you for your trust! 📸✨   \n","\n","                                      hashtags_clean              cta_clean  \n","0  loyaltylovers drinkup winebarreward tasteexplorer        Check your DMs!  \n","1            flashgiveaway co_work winprize workplay             Enter now!  \n","2          veganveggie plantbased vegantips veganjoy  Like if you're vegan!  \n","3         beforeandafter bookish readmore bookaddict     Tell us which one!  \n","4   photographylove trustworthy photostudio photojoy     Share your photos!  "]},"execution_count":9,"metadata":{},"output_type":"execute_result"}],"source":["# =====================================================================================\n","# CELL 8 - CLEAN AND PREPARE THE DATA\n","# PURPOSE : Fix the formatting problems found in Cells 4-7 and build the clean \"library\" of examples.\n","# WHY     : Examples shown to an LLM must be consistent, otherwise it copies the mess.\n","# STEPS   : (1) hashtags -> lowercase list without \"#\"  (2) remove leaked #hashtags from captions\n","#           (3) normalise CTAs  (4) flag low-quality rows  (5) build the text used for searching.\n","# RESULT  : `library` = the clean rows (about 1,438 of 1,447).\n","# =====================================================================================\n","# (1) Hashtags: keep only letters/numbers/underscore, lowercase, remove duplicates but keep order\n","def clean_hashtags(h):\n","    tags = [t.lower() for t in re.findall(r\"[A-Za-z0-9_]+\", str(h))]\n","    seen, out = set(), []\n","    for t in tags:\n","        if t not in seen:\n","            seen.add(t); out.append(t)\n","    return out\n","\n","df[\"hashtag_list\"]   = df[\"hashtags\"].map(clean_hashtags)                 # list form, e.g. ['winebar','nightcap']\n","df[\"hashtags_clean\"] = df[\"hashtag_list\"].map(lambda L: \" \".join(L))      # text form, used for searching\n","df[\"hashtag_count\"]  = df[\"hashtag_list\"].map(len)\n","\n","# (2) Captions: remove any \"#word\" that leaked into the caption body, then tidy spaces\n","def clean_caption(c):\n","    c = re.sub(r\"#\\w+\", \"\", str(c))\n","    return re.sub(r\"\\s+\", \" \", c).strip()\n","\n","df[\"caption_clean\"] = df[\"caption\"].map(clean_caption)\n","df[\"caption_words\"] = df[\"caption_clean\"].map(lambda s: len(s.split()))\n","\n","# (3) CTA: keep a readable version and a lowercase \"key\" version for counting\n","df[\"cta_clean\"] = df[\"cta\"].astype(str).str.strip()\n","df[\"cta_key\"]   = df[\"cta_clean\"].str.lower().str.replace(r\"[^\\w\\s]\", \"\", regex=True).str.strip()\n","\n","# (4) Quality flag: a usable example needs a caption of 4+ words, at least 2 hashtags, and a CTA\n","df[\"quality_ok\"] = (df[\"caption_words\"] >= 4) & (df[\"hashtag_count\"] >= 2) & (df[\"cta_key\"].str.len() > 0)\n","\n","# (5) Searchable text\n","df[\"brief_text\"] = (df[\"business_type\"] + \", \" + df[\"brand_voice\"] + \", \" + df[\"occasion\"] + \", \"\n","                    + df[\"format\"] + \", \" + df[\"brand_palette\"])\n","df[\"doc_text\"] = (df[\"business_type\"] + \" \" + df[\"occasion\"] + \" \" + df[\"hashtags_clean\"] + \" \"\n","                  + df[\"caption_clean\"] + \" \" + df[\"image_prompt\"].astype(str)).str.lower()\n","\n","print(\"Rows total                       :\", len(df))\n","print(\"Rows passing quality_ok          :\", int(df[\"quality_ok\"].sum()))\n","print(\"Rows excluded from the library   :\", int((~df['quality_ok']).sum()))\n","print(\"Captions that still contain '#'  :\", int(df['caption_clean'].str.contains('#').sum()))\n","print(\"Hashtag lists with '#' symbol    :\", int(df['hashtags_clean'].str.contains('#').sum()))\n","\n","library = df[df[\"quality_ok\"]].reset_index(drop=True)    # the clean example library\n","print(\"Library size:\", len(library))\n","library[[\"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\", \"hashtags_clean\", \"cta_clean\"]].head(5)"]},{"cell_type":"code","execution_count":10,"id":"0ab49146","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:48:59.895535Z","iopub.status.busy":"2026-10-07T04:48:59.89479Z","iopub.status.idle":"2026-10-07T04:48:59.911587Z","shell.execute_reply":"2026-10-07T04:48:59.910335Z"},"papermill":{"duration":0.029526,"end_time":"2026-10-07T04:48:59.913514+00:00","exception":false,"start_time":"2026-10-07T04:48:59.883988+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>value</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>usable examples</th>\n","      <td>1438.0000</td>\n","    </tr>\n","    <tr>\n","      <th>business types</th>\n","      <td>30.0000</td>\n","    </tr>\n","    <tr>\n","      <th>average caption length (words)</th>\n","      <td>9.1000</td>\n","    </tr>\n","    <tr>\n","      <th>avg examples per (voice, occasion, format) combo</th>\n","      <td>4.5000</td>\n","    </tr>\n","    <tr>\n","      <th>share of captions that are unique</th>\n","      <td>0.9993</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["                                                      value\n","usable examples                                   1438.0000\n","business types                                      30.0000\n","average caption length (words)                       9.1000\n","avg examples per (voice, occasion, format) combo     4.5000\n","share of captions that are unique                    0.9993"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Typical sizes for useful LLM fine-tuning: several thousand+ varied, high-quality examples.\n","This library has 1,438 short, synthetic examples -> too small and too uniform to teach a model new writing skills.\n","Best use: a small, searchable library of STYLE EXAMPLES that guides a stronger LLM at generation time.\n"]}],"source":["# =====================================================================================\n","# CELL 9 - DECISION CHECK: TRAIN/FINE-TUNE A MODEL, OR USE THE DATA AS A LIBRARY?\n","# PURPOSE : Put numbers behind the choice of approach.\n","# WHY     : The method must follow from the data, not from what is popular.\n","# CONCLUSION: ~1,400 very short synthetic captions, about 4.5 per (voice, occasion, format) combination,\n","#           are too few and too uniform to teach a model writing skills. They are well suited\n","#           to being a searchable library of style examples.\n","# =====================================================================================\n","n = len(library)\n","per_combo = library.groupby([\"brand_voice\", \"occasion\", \"format\"]).size()    # examples per (voice, occasion, format)\n","summary = pd.DataFrame({\"value\": [n, library[\"business_type\"].nunique(), round(library[\"caption_words\"].mean(), 1),\n","                                  round(per_combo.mean(), 1), round(library[\"caption_clean\"].nunique() / n, 4)]},\n","                       index=[\"usable examples\", \"business types\", \"average caption length (words)\",\n","                              \"avg examples per (voice, occasion, format) combo\", \"share of captions that are unique\"])\n","display(summary)\n","print(\"Typical sizes for useful LLM fine-tuning: several thousand+ varied, high-quality examples.\")\n","print(f\"This library has {n:,} short, synthetic examples -> too small and too uniform to teach a model new writing skills.\")\n","print(\"Best use: a small, searchable library of STYLE EXAMPLES that guides a stronger LLM at generation time.\")"]},{"cell_type":"code","execution_count":11,"id":"bb840195","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:48:59.936397Z","iopub.status.busy":"2026-10-07T04:48:59.936087Z","iopub.status.idle":"2026-10-07T04:49:00.082683Z","shell.execute_reply":"2026-10-07T04:49:00.081634Z"},"papermill":{"duration":0.161169,"end_time":"2026-10-07T04:49:00.084633+00:00","exception":false,"start_time":"2026-10-07T04:48:59.923464+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["TF-IDF vocabulary size: 21754 | matrix shape: (1438, 21754)\n","Retriever ready.\n"]}],"source":["# =====================================================================================\n","# CELL 10 - BUILD THE RETRIEVER (the \"model\" of this notebook)\n","# METHOD  : Weighted similarity search. NOT a trained model, no learning from labels.\n","#           score = weighted sum of\n","#              exact match on occasion (0.35), brand voice (0.25), format (0.10), palette (0.05)\n","#              + TF-IDF text similarity between the business description and each example (0.25)\n","#           If the user leaves a field out, its weight is dropped and the rest is rescaled.\n","# WHY     : A new business (e.g. civil works) is NOT in the data. Matching on occasion, voice and\n","#           format still finds examples with the right STRUCTURE; the text part helps when the\n","#           business description shares words with an example.\n","# RESULT  : functions `score_examples` and `retrieve_examples`, ready to use.\n","# =====================================================================================\n","W = {\"occasion\": 0.35, \"voice\": 0.25, \"format\": 0.10, \"palette\": 0.05, \"text\": 0.25}    # importance of each signal\n","\n","# TF-IDF: converts text into numbers where rare, informative words count more than common ones.\n","tfidf = TfidfVectorizer(ngram_range=(1, 2),      # single words and word pairs\n","                        sublinear_tf=True,       # damp the effect of repeated words\n","                        stop_words=\"english\",    # ignore words like \"the\", \"and\"\n","                        min_df=1)\n","doc_matrix = tfidf.fit_transform(library[\"doc_text\"])        # one numeric vector per library example\n","RET = {\"vectorizer\": tfidf, \"doc_matrix\": doc_matrix, \"library\": library, \"weights\": W}   # bundle everything together\n","print(\"TF-IDF vocabulary size:\", len(tfidf.vocabulary_), \"| matrix shape:\", doc_matrix.shape)\n","\n","def score_examples(query, ret=RET, exclude_idx=None, exclude_business=None):\n","    \"\"\"Give every library example a similarity score (0-1) to the query brief.\"\"\"\n","    lib = ret[\"library\"]; w = ret[\"weights\"]\n","    total = np.zeros(len(lib)); used = 0.0\n","    # exact-match signals: add the weight where the example's field equals the requested value\n","    for key, col, wk in [(\"occasion\", \"occasion\", \"occasion\"), (\"brand_voice\", \"brand_voice\", \"voice\"),\n","                         (\"format\", \"format\", \"format\"), (\"brand_palette\", \"brand_palette\", \"palette\")]:\n","        if query.get(key):\n","            total += w[wk] * (lib[col].values == query[key]); used += w[wk]\n","    # text signal: how similar is the business description to each example's text?\n","    if query.get(\"business_text\"):\n","        q = ret[\"vectorizer\"].transform([query[\"business_text\"].lower()])\n","        total += w[\"text\"] * cosine_similarity(q, ret[\"doc_matrix\"]).ravel(); used += w[\"text\"]\n","    score = total / used if used > 0 else total       # rescale so missing fields do not lower the score\n","    if exclude_idx is not None:      score[exclude_idx] = -1                                   # used only for testing\n","    if exclude_business is not None: score[(lib[\"business_type\"].values == exclude_business)] = -1   # used only for testing\n","    return score\n","\n","def retrieve_examples(query, k=3, max_per_business=1, ret=RET, exclude_idx=None, exclude_business=None):\n","    \"\"\"Return the k best-matching examples, with at most `max_per_business` from the same business type (for variety).\"\"\"\n","    lib = ret[\"library\"]\n","    score = score_examples(query, ret, exclude_idx, exclude_business)\n","    order = np.argsort(-score, kind=\"stable\")          # best first\n","    picked, count = [], {}\n","    for i in order:\n","        if score[i] < 0: break                          # excluded rows are marked -1\n","        b = lib.at[i, \"business_type\"]\n","        if count.get(b, 0) >= max_per_business: continue   # diversity rule\n","        picked.append(i); count[b] = count.get(b, 0) + 1\n","        if len(picked) == k: break\n","    out = lib.loc[picked, [\"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\",\n","                           \"hashtags_clean\", \"cta_clean\", \"image_prompt\"]].copy()\n","    out.insert(0, \"score\", score[picked].round(3))\n","    return out\n","print(\"Retriever ready.\")"]},{"cell_type":"code","execution_count":12,"id":"3188e1b7","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:49:00.105933Z","iopub.status.busy":"2026-10-07T04:49:00.10557Z","iopub.status.idle":"2026-10-07T04:49:00.13068Z","shell.execute_reply":"2026-10-07T04:49:00.129699Z"},"papermill":{"duration":0.038257,"end_time":"2026-10-07T04:49:00.132727+00:00","exception":false,"start_time":"2026-10-07T04:49:00.09447+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>score</th>\n","      <th>business_type</th>\n","      <th>brand_voice</th>\n","      <th>occasion</th>\n","      <th>format</th>\n","      <th>caption_clean</th>\n","      <th>cta_clean</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>115</th>\n","      <td>0.737</td>\n","      <td>organic grocery</td>\n","      <td>warm and friendly</td>\n","      <td>grand opening</td>\n","      <td>feed post</td>\n","      <td>Celebrate with us on our grand opening! 🎉</td>\n","      <td>Visit Us Today</td>\n","    </tr>\n","    <tr>\n","      <th>837</th>\n","      <td>0.737</td>\n","      <td>vegan restaurant</td>\n","      <td>warm and friendly</td>\n","      <td>grand opening</td>\n","      <td>feed post</td>\n","      <td>Celebrate the opening of our new vegan oasis! 🌼🌱</td>\n","      <td>Join us for the grand opening!</td>\n","    </tr>\n","    <tr>\n","      <th>154</th>\n","      <td>0.632</td>\n","      <td>accounting firm</td>\n","      <td>warm and friendly</td>\n","      <td>grand opening</td>\n","      <td>story</td>\n","      <td>Join the celebration at [Brand]'s grand opening!</td>\n","      <td>Visit us!</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["     score     business_type        brand_voice       occasion     format  \\\n","115  0.737   organic grocery  warm and friendly  grand opening  feed post   \n","837  0.737  vegan restaurant  warm and friendly  grand opening  feed post   \n","154  0.632   accounting firm  warm and friendly  grand opening      story   \n","\n","                                        caption_clean  \\\n","115         Celebrate with us on our grand opening! 🎉   \n","837  Celebrate the opening of our new vegan oasis! 🌼🌱   \n","154  Join the celebration at [Brand]'s grand opening!   \n","\n","                          cta_clean  \n","115                  Visit Us Today  \n","837  Join us for the grand opening!  \n","154                       Visit us!  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["[0.737] organic grocery: Celebrate with us on our grand opening! 🎉  | #luxurygrocery #freshnessinbaskets #goldandcream #grandopening  | CTA: Visit Us Today\n","[0.737] vegan restaurant: Celebrate the opening of our new vegan oasis! 🌼🌱  | #veganoasis #plantbasedopening #ecofriendly #foodieevent  | CTA: Join us for the grand opening!\n","[0.632] accounting firm: Join the celebration at [Brand]'s grand opening!  | #welcometo #accounting #trustedadvice #monochrome  | CTA: Visit us!\n"]}],"source":["# =====================================================================================\n","# CELL 11 - TRY THE RETRIEVER ON AN EXAMPLE\n","# PURPOSE : Show what a retrieval result looks like.\n","# QUERY   : \"a bakery wanting a friendly feed post for its grand opening\"\n","# CHECK   : Every result should be a \"grand opening\" feed post in a \"warm and friendly\" voice.\n","# =====================================================================================\n","demo_query = {\"business_text\": \"bakery fresh bread pastries\", \"brand_voice\": \"warm and friendly\",\n","              \"occasion\": \"grand opening\", \"format\": \"feed post\"}\n","res = retrieve_examples(demo_query, k=3)\n","display(res[[\"score\", \"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\", \"cta_clean\"]])\n","for _, r in res.iterrows():\n","    print(f\"[{r['score']}] {r['business_type']}: {r['caption_clean']}  | #{' #'.join(r['hashtags_clean'].split())}  | CTA: {r['cta_clean']}\")"]},{"cell_type":"code","execution_count":13,"id":"83ec6a1b","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:49:00.153971Z","iopub.status.busy":"2026-10-07T04:49:00.153559Z","iopub.status.idle":"2026-10-07T04:49:05.66367Z","shell.execute_reply":"2026-10-07T04:49:05.662692Z"},"papermill":{"duration":5.52325,"end_time":"2026-10-07T04:49:05.665578+00:00","exception":false,"start_time":"2026-10-07T04:49:00.142328+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["=== Retrieval quality (top-3, 500 test briefs) ===\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>occasion match</th>\n","      <th>voice match</th>\n","      <th>format match</th>\n","      <th>all three match</th>\n","    </tr>\n","    <tr>\n","      <th>test</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>A. Seen business type (leave the post itself out)</th>\n","      <td>1.000</td>\n","      <td>0.993</td>\n","      <td>0.911</td>\n","      <td>0.904</td>\n","    </tr>\n","    <tr>\n","      <th>B. UNSEEN business type (whole business removed)</th>\n","      <td>1.000</td>\n","      <td>0.991</td>\n","      <td>0.905</td>\n","      <td>0.897</td>\n","    </tr>\n","    <tr>\n","      <th>C. Random baseline (3 random examples)</th>\n","      <td>0.055</td>\n","      <td>0.117</td>\n","      <td>0.495</td>\n","      <td>0.004</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["                                                   occasion match  \\\n","test                                                                \n","A. Seen business type (leave the post itself out)           1.000   \n","B. UNSEEN business type (whole business removed)            1.000   \n","C. Random baseline (3 random examples)                      0.055   \n","\n","                                                   voice match  format match  \\\n","test                                                                           \n","A. Seen business type (leave the post itself out)        0.993         0.911   \n","B. UNSEEN business type (whole business removed)         0.991         0.905   \n","C. Random baseline (3 random examples)                   0.117         0.495   \n","\n","                                                   all three match  \n","test                                                                \n","A. Seen business type (leave the post itself out)            0.904  \n","B. UNSEEN business type (whole business removed)             0.897  \n","C. Random baseline (3 random examples)                       0.004  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","=== D. Business-type retrieval from a plain-English description (no categories given) ===\n","  bakery               <- 'fresh bread cakes and pastries sho' -> ['bakery', 'bakery', 'bakery'] OK\n","  dental clinic        <- 'teeth cleaning dentist smile care ' -> ['dental clinic', 'dental clinic', 'car wash'] OK\n","  fitness gym          <- 'weights workout training membershi' -> ['fitness gym', 'fitness gym', 'fitness gym'] OK\n","  florist              <- 'flowers bouquets blooms delivery  ' -> ['florist', 'florist', 'florist'] OK\n","  car wash             <- 'cars cleaning shine wash          ' -> ['car wash', 'car wash', 'car wash'] OK\n","  law firm             <- 'legal advice lawyers court        ' -> ['law firm', 'law firm', 'accounting firm'] OK\n","  hair salon           <- 'haircut styling colour stylist    ' -> ['hair salon', 'hair salon', 'hair salon'] OK\n","  yoga studio          <- 'yoga classes mindfulness stretchin' -> ['yoga studio', 'yoga studio', 'yoga studio'] OK\n","  pet grooming salon   <- 'dog grooming pets fur             ' -> ['pet grooming salon', 'pet grooming salon', 'pet grooming salon'] OK\n","  wedding planner      <- 'weddings bride event planning     ' -> ['wedding planner', 'wedding planner', 'wedding planner'] OK\n","Hit@3 on paraphrased descriptions: 10/10  (10 hand-written descriptions: a small sanity check, not a benchmark)\n","\n","=== E. Diversity of the 3 retrieved examples ===\n","Average distinct business types among 3 results (before diversity rule): 2.74\n","Average distinct business types among 3 results (with diversity rule)  : 3.0\n"]}],"source":["# =====================================================================================\n","# CELL 12 - EVALUATE THE RETRIEVER\n","# WHY THESE METRICS: Accuracy/R2 do not apply because nothing is predicted. For a retrieval\n","#           library the question is \"does it return examples that fit the brief?\".\n","# TESTS   : A. Seen business   - the example itself is hidden, its business type is still in the library.\n","#           B. UNSEEN business - ALL rows of that business type are hidden. This imitates a new customer\n","#              (like civil works) that the dataset has never seen. The most important test.\n","#           C. Random baseline - 3 random examples, to show the scores are meaningful.\n","#           D. Plain-English descriptions - can free text alone find the right business type?\n","#           E. Diversity       - are the 3 results from different business types?\n","# HONEST NOTE: occasion/voice matching is partly BY DESIGN (we search on those fields), so the number to\n","#           look at is how much higher A/B are than the random baseline, and that B stays close to A.\n","# =====================================================================================\n","lib = RET[\"library\"]; K = 3\n","\n","def match_rates(pred_idx_lists, truth_rows):\n","    \"\"\"Average share of retrieved examples whose occasion/voice/format equal the requested ones.\"\"\"\n","    occ = voi = fmt = allm = 0\n","    for idxs, t in zip(pred_idx_lists, truth_rows):\n","        got = lib.loc[idxs]\n","        occ  += (got[\"occasion\"] == t[\"occasion\"]).mean()\n","        voi  += (got[\"brand_voice\"] == t[\"brand_voice\"]).mean()\n","        fmt  += (got[\"format\"] == t[\"format\"]).mean()\n","        allm += ((got[\"occasion\"] == t[\"occasion\"]) & (got[\"brand_voice\"] == t[\"brand_voice\"]) & (got[\"format\"] == t[\"format\"])).mean()\n","    n = len(truth_rows)\n","    return occ / n, voi / n, fmt / n, allm / n\n","\n","def top_idx(query, **kw):                       # row numbers of the top-K scoring examples\n","    s = score_examples(query, **kw)\n","    return list(np.argsort(-s, kind=\"stable\")[:K])\n","\n","rng = np.random.RandomState(SEED)\n","sample_rows = lib.sample(500, random_state=SEED)        # 500 test briefs taken from the library\n","truths = [r for _, r in sample_rows.iterrows()]\n","\n","def make_query(r):                                       # turn a library row into a search query\n","    return {\"business_text\": r[\"business_type\"], \"brand_voice\": r[\"brand_voice\"], \"occasion\": r[\"occasion\"],\n","            \"format\": r[\"format\"], \"brand_palette\": r[\"brand_palette\"]}\n","\n","res_rows = []\n","seen = [top_idx(make_query(r), exclude_idx=i) for i, r in sample_rows.iterrows()]\n","res_rows.append((\"A. Seen business type (leave the post itself out)\",) + match_rates(seen, truths))\n","unseen = [top_idx(make_query(r), exclude_business=r[\"business_type\"]) for _, r in sample_rows.iterrows()]\n","res_rows.append((\"B. UNSEEN business type (whole business removed)\",) + match_rates(unseen, truths))\n","rand = [list(rng.choice(len(lib), K, replace=False)) for _ in truths]\n","res_rows.append((\"C. Random baseline (3 random examples)\",) + match_rates(rand, truths))\n","\n","table = pd.DataFrame(res_rows, columns=[\"test\", \"occasion match\", \"voice match\", \"format match\", \"all three match\"]).set_index(\"test\").round(3)\n","print(\"=== Retrieval quality (top-3, 500 test briefs) ===\"); display(table)\n","\n","print(\"\\n=== D. Business-type retrieval from a plain-English description (no categories given) ===\")\n","paraphrase = {\"bakery\": \"fresh bread cakes and pastries shop\", \"dental clinic\": \"teeth cleaning dentist smile care\",\n","              \"fitness gym\": \"weights workout training membership\", \"florist\": \"flowers bouquets blooms delivery\",\n","              \"car wash\": \"cars cleaning shine wash\", \"law firm\": \"legal advice lawyers court\",\n","              \"hair salon\": \"haircut styling colour stylist\", \"yoga studio\": \"yoga classes mindfulness stretching\",\n","              \"pet grooming salon\": \"dog grooming pets fur\", \"wedding planner\": \"weddings bride event planning\"}\n","hits = 0\n","for true_b, text in paraphrase.items():\n","    got = retrieve_examples({\"business_text\": text}, k=3, max_per_business=3)[\"business_type\"].tolist()\n","    hit = true_b in got; hits += hit\n","    print(f\"  {true_b:20s} <- '{text[:34]:34s}' -> {got} {'OK' if hit else 'MISS'}\")\n","print(f\"Hit@3 on paraphrased descriptions: {hits}/{len(paraphrase)}  (10 hand-written descriptions: a small sanity check, not a benchmark)\")\n","\n","print(\"\\n=== E. Diversity of the 3 retrieved examples ===\")\n","div  = [lib.loc[top_idx(make_query(r))][\"business_type\"].nunique() for _, r in sample_rows.head(200).iterrows()]\n","print(\"Average distinct business types among 3 results (before diversity rule):\", round(np.mean(div), 2))\n","div2 = [retrieve_examples(make_query(r), k=3)[\"business_type\"].nunique() for _, r in sample_rows.head(200).iterrows()]\n","print(\"Average distinct business types among 3 results (with diversity rule)  :\", round(np.mean(div2), 2))"]},{"cell_type":"code","execution_count":14,"id":"b833594a","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:49:05.687613Z","iopub.status.busy":"2026-10-07T04:49:05.687104Z","iopub.status.idle":"2026-10-07T04:49:05.697527Z","shell.execute_reply":"2026-10-07T04:49:05.696238Z"},"papermill":{"duration":0.023939,"end_time":"2026-10-07T04:49:05.699494+00:00","exception":false,"start_time":"2026-10-07T04:49:05.675555+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Marketing brief created successfully.\n","\n","business_type: Civil Works Company\n","service: Bathroom Renovation\n","target_customer: Homeowners\n","platform: Instagram\n","marketing_goal: Generate Enquiries\n","brand_voice: Professional and Trustworthy\n","location: Chennai\n","content_format: Feed Post\n","occasion: Before and After\n","brand_palette: Muted Neutrals\n","\n","--- Vocabulary check (can the dataset match these exactly?) ---\n","  OK       brand_voice    = 'professional and trustworthy'\n","  OK       occasion       = 'before and after'\n","  OK       content_format = 'feed post'\n","  OK       brand_palette  = 'muted neutrals'\n"]}],"source":["# =====================================================================================\n","# CELL 13A - DEFINE THE USER'S MARKETING BRIEF (+ check it against the dataset's vocabulary)\n","# PURPOSE : Represent what a real business user types into the website.\n","# WHY     : These fields drive the caption, hashtags, CTA, content idea and image prompt.\n","#           TARGET CUSTOMER, SERVICE, GOAL and LOCATION come from the USER (Dataset 5 has no civil-works knowledge).\n","# IMPORTANT CHECK: Dataset 5 stores voices, occasions, formats and palettes in lowercase (e.g. \"before and after\").\n","#           We compare the brief with those allowed values, so a mismatch is reported instead of silently\n","#           returning unrelated examples.\n","# =====================================================================================\n","marketing_brief = {\n","    \"business_type\":   \"Civil Works Company\",\n","    \"service\":         \"Bathroom Renovation\",\n","    \"target_customer\": \"Homeowners\",\n","    \"platform\":        \"Instagram\",\n","    \"marketing_goal\":  \"Generate Enquiries\",\n","    \"brand_voice\":     \"Professional and Trustworthy\",\n","    \"location\":        \"Chennai\",\n","    \"content_format\":  \"Feed Post\",\n","    \"occasion\":        \"Before and After\",\n","    \"brand_palette\":   \"Muted Neutrals\",\n","}\n","print(\"Marketing brief created successfully.\\n\")\n","for key, value in marketing_brief.items():\n","    print(f\"{key}: {value}\")\n","\n","# The values Dataset 5 knows about, per field. (brief field -> library column)\n","VOCAB = {\"brand_voice\": set(library[\"brand_voice\"]), \"occasion\": set(library[\"occasion\"]),\n","         \"format\": set(library[\"format\"]), \"brand_palette\": set(library[\"brand_palette\"])}\n","BRIEF_TO_LIB = {\"brand_voice\": \"brand_voice\", \"occasion\": \"occasion\",\n","                \"content_format\": \"format\", \"brand_palette\": \"brand_palette\"}\n","\n","def check_brief_vocabulary(brief):\n","    \"\"\"Report which brief fields can be matched exactly against Dataset 5 (case-insensitive).\"\"\"\n","    print(\"\\n--- Vocabulary check (can the dataset match these exactly?) ---\")\n","    for brief_key, lib_col in BRIEF_TO_LIB.items():\n","        value = str(brief.get(brief_key, \"\")).strip().lower()\n","        if value in VOCAB[lib_col]:\n","            print(f\"  OK       {brief_key:14s} = '{value}'\")\n","        else:\n","            print(f\"  NOT FOUND {brief_key:13s} = '{value}'  -> ignored for matching. Allowed: {sorted(VOCAB[lib_col])}\")\n","check_brief_vocabulary(marketing_brief)"]},{"cell_type":"code","execution_count":15,"id":"df71092a","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:49:05.722181Z","iopub.status.busy":"2026-10-07T04:49:05.721522Z","iopub.status.idle":"2026-10-07T04:49:05.743648Z","shell.execute_reply":"2026-10-07T04:4