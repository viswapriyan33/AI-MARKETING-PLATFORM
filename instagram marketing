s found in the raw text ===\")\nprint(\"Captions containing '#' (hashtags leaked into caption):\", int(df[\"caption\"].str.contains(\"#\").sum()))\nprint(\"Hashtag cells that include the '#' symbol            :\", int(df[\"hashtags\"].str.contains(\"#\").sum()), \"of\", len(df))\nprint(\"Captions shorter than 4 words                        :\", int((df[\"_caption_words\"] < 4).sum()))\nemoji_share = df[\"caption\"].str.contains(r\"[^\\x00-\\x7F]\").mean()     # non-ASCII characters = mostly emoji\nprint(\"Captions containing emoji / non-ASCII                :\", f\"{emoji_share:.1%}\")\n\n# CTAs: \"Book now\" and \"Book Now!\" are the same CTA, so compare after lowercasing and removing punctuation\ncta_key = df[\"cta\"].str.lower().str.replace(r\"[^\\w\\s]\", \"\", regex=True).str.strip()\nprint(f\"\\nCTA unique as written: {df['cta'].nunique()} | after ignoring case/punctuation: {cta_key.nunique()}\")\nprint(\"\\nTop 10 CTAs (normalised):\"); print(cta_key.value_counts().head(10))\n\nfig, axes = plt.subplots(1, 3, figsize=(16, 4))\nsns.histplot(df[\"_caption_words\"], bins=20, ax=axes[0], color=\"teal\");   axes[0].set_title(\"Caption length (words)\")\nsns.histplot(df[\"_hashtag_count\"], bins=range(0, 10), ax=axes[1], color=\"orange\"); axes[1].set_title(\"Hashtags per post\")\nsns.histplot(df[\"_cta_words\"], bins=range(0, 8), ax=axes[2], color=\"purple\");      axes[2].set_title(\"CTA length (words)\")\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:34:56.768193Z","iopub.execute_input":"2026-10-04T03:34:56.768533Z","iopub.status.idle":"2026-10-04T03:34:57.372999Z","shell.execute_reply.started":"2026-10-04T03:34:56.768509Z","shell.execute_reply":"2026-10-04T03:34:57.372017Z"}},"outputs":[{"name":"stdout","text":"--- Caption length (words) ---\ncount    1447.00\nmean        9.79\nstd         3.39\nmin         3.00\n25%         7.00\n50%         9.00\n75%        12.00\nmax        25.00\nName: _caption_words, dtype: float64\n\n--- Hashtags per post ---\ncount    1447.00\nmean        4.02\nstd         0.23\nmin         2.00\n25%         4.00\n50%         4.00\n75%         4.00\nmax         8.00\nName: _hashtag_count, dtype: float64\n\n--- CTA length (words) ---\ncount    1447.00\nmean        2.50\nstd         0.67\nmin         1.00\n25%         2.00\n50%         2.00\n75%         3.00\nmax         6.00\nName: _cta_words, dtype: float64\n\n=== Formatting problems found in the raw text ===\nCaptions containing '#' (hashtags leaked into caption): 322\nHashtag cells that include the '#' symbol            : 653 of 1447\nCaptions shorter than 4 words                        : 5\nCaptions containing emoji / non-ASCII                : 86.7%\n\nCTA unique as written: 665 | after ignoring case/punctuation: 489\n\nTop 10 CTAs (normalised):\ncta\nshop now          143\nbook now           94\njoin us            61\nlearn more         53\nenter now          48\nvisit us           47\nexplore now        38\norder now          36\nsee more           21\nvisit us today     20\nName: count, dtype: int64\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x400 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":132},{"cell_type":"code","source":"# =====================================================================================\n# CELL 7 - ANALYSE THE IMAGE-RELATED FIELDS\n# PURPOSE : Check whether image files are actually available, and how good the image prompts are.\n# WHY     : The CSV only stores a text path such as /content/social_data/images/img_00000.png from the\n#           creator's computer. The pictures themselves are a separate folder. If the files are not\n#           attached to this notebook, this notebook can only use the image PROMPTS (text).\n# KEY FINDING: image prompts often ignore the palette (e.g. \"muted neutrals\" appears in only ~25% of its prompts).\n# =====================================================================================\nIMAGE_DIR_GUESS = glob.glob(\"/kaggle/input/**/images\", recursive=True)   # any \"images\" folder among Kaggle inputs\n\ndef find_image_file(image_path):\n    \"\"\"Return a real file path for a given image_path, or None if the picture is not available.\"\"\"\n    if not isinstance(image_path, str):\n        return None\n    if os.path.exists(image_path):                       # the stored path works as-is\n        return image_path\n    base = os.path.basename(image_path)                  # otherwise try just the file name in known folders\n    for folder in IMAGE_DIR_GUESS:\n        cand = os.path.join(folder, base)\n        if os.path.exists(cand):\n            return cand\n    return None\n\nwith_img = df[df[\"has_image\"]]\nfound = with_img[\"image_path\"].map(find_image_file)\nprint(\"Rows flagged has_image            :\", len(with_img))\nprint(\"Image files actually found on disk:\", int(found.notna().sum()))\n\nif found.notna().sum() == 0:\n    print(\"-> No image files are available in this notebook (the CSV only stores a path from the creator's environment).\")\n    print(\"   This does not affect the text-based method; image prompts are still used as text.\")\nelse:\n    from PIL import Image                                # show 3 random images with their business and occasion\n    sample = with_img[found.notna()].sample(3, random_state=SEED)\n    fig, axes = plt.subplots(1, 3, figsize=(14, 5))\n    for ax, (_, r) in zip(axes, sample.iterrows()):\n        ax.imshow(Image.open(find_image_file(r[\"image_path\"]))); ax.axis(\"off\")\n        ax.set_title(f\"{r['business_type']} | {r['occasion']}\", fontsize=9)\n    plt.show()\n\ndf[\"_prompt_words\"] = df[\"image_prompt\"].map(lambda s: len(str(s).split()))\nprint(\"\\n--- image_prompt length (words) ---\"); print(df[\"_prompt_words\"].describe().round(2))\n\n# Does the image prompt actually mention the colours of the palette it was generated for?\nSTOP = {\"and\", \"the\", \"with\", \"soft\", \"tones\", \"colors\", \"color\"}      # filler words to ignore\ndef palette_hit(row):\n    keys = [w for w in re.findall(r\"[a-z]+\", row[\"brand_palette\"].lower()) if len(w) > 3 and w not in STOP]\n    return any(k in row[\"image_prompt\"].lower() for k in keys)\ndf[\"_palette_in_prompt\"] = df.apply(palette_hit, axis=1)\nprint(\"\\nShare of image prompts that mention their palette's key words, by palette:\")\nprint(df.groupby(\"brand_palette\")[\"_palette_in_prompt\"].mean().round(2).sort_values())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:34:57.37434Z","iopub.execute_input":"2026-10-04T03:34:57.374669Z","iopub.status.idle":"2026-10-04T03:34:57.432286Z","shell.execute_reply.started":"2026-10-04T03:34:57.374643Z","shell.execute_reply":"2026-10-04T03:34:57.431309Z"}},"outputs":[{"name":"stdout","text":"Rows flagged has_image            : 1000\nImage files actually found on disk: 0\n-> No image files are available in this notebook (the CSV only stores a path from the creator's environment).\n   This does not affect the text-based method; image prompts are still used as text.\n\n--- image_prompt length (words) ---\ncount    1447.00\nmean       13.06\nstd         2.95\nmin         1.00\n25%        11.00\n50%        13.00\n75%        15.00\nmax        24.00\nName: _prompt_words, dtype: float64\n\nShare of image prompts that mention their palette's key words, by palette:\nbrand_palette\nmuted neutrals                0.25\nforest greens                 0.39\nocean blues and teals         0.53\nwarm earthy tones             0.63\ngold and cream luxury         0.74\nmonochrome black and white    0.77\npastel and soft               0.78\nvibrant and colorful          0.87\nName: _palette_in_prompt, dtype: float64\n","output_type":"stream"}],"execution_count":133},{"cell_type":"code","source":"# =====================================================================================\n# CELL 8 - CLEAN AND PREPARE THE