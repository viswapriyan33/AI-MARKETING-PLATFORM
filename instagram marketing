ze()    # examples per (voice, occasion, format)\nsummary = pd.DataFrame({\"value\": [n, library[\"business_type\"].nunique(), round(library[\"caption_words\"].mean(), 1),\n                                  round(per_combo.mean(), 1), round(library[\"caption_clean\"].nunique() / n, 4)]},\n                       index=[\"usable examples\", \"business types\", \"average caption length (words)\",\n                              \"avg examples per (voice, occasion, format) combo\", \"share of captions that are unique\"])\ndisplay(summary)\nprint(\"Typical sizes for useful LLM fine-tuning: several thousand+ varied, high-quality examples.\")\nprint(f\"This library has {n:,} short, synthetic examples -> too small and too uniform to teach a model new writing skills.\")\nprint(\"Best use: a small, searchable library of STYLE EXAMPLES that guides a stronger LLM at generation time.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:34:57.512621Z","iopub.execute_input":"2026-10-04T03:34:57.51293Z","iopub.status.idle":"2026-10-04T03:34:57.531535Z","shell.execute_reply.started":"2026-10-04T03:34:57.512905Z","shell.execute_reply":"2026-10-04T03:34:57.530585Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"                                                      value\nusable examples                                   1438.0000\nbusiness types                                      30.0000\naverage caption length (words)                       9.1000\navg examples per (voice, occasion, format) combo     4.5000\nshare of captions that are unique                    0.9993","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>value</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>usable examples</th>\n      <td>1438.0000</td>\n    </tr>\n    <tr>\n      <th>business types</th>\n      <td>30.0000</td>\n    </tr>\n    <tr>\n      <th>average caption length (words)</th>\n      <td>9.1000</td>\n    </tr>\n    <tr>\n      <th>avg examples per (voice, occasion, format) combo</th>\n      <td>4.5000</td>\n    </tr>\n    <tr>\n      <th>share of captions that are unique</th>\n      <td>0.9993</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"Typical sizes for useful LLM fine-tuning: several thousand+ varied, high-quality examples.\nThis library has 1,438 short, synthetic examples -> too small and too uniform to teach a model new writing skills.\nBest use: a small, searchable library of STYLE EXAMPLES that guides a stronger LLM at generation time.\n","output_type":"stream"}],"execution_count":135},{"cell_type":"code","source":"# =====================================================================================\n# CELL 10 - BUILD THE RETRIEVER (the \"model\" of this notebook)\n# METHOD  : Weighted similarity search. NOT a trained model, no learning from labels.\n#           score = weighted sum of\n#              exact match on occasion (0.35), brand voice (0.25), format (0.10), palette (0.05)\n#              + TF-IDF text similarity between the business description and each example (0.25)\n#           If the user leaves a field out, its weight is dropped and the rest is rescaled.\n# WHY     : A new business (e.g. civil works) is NOT in the data. Matching on occasion, voice and\n#           format still finds examples with the right STRUCTURE; the text part helps when the\n#           business description shares words with an example.\n# RESULT  : functions `score_examples` and `retrieve_examples`, ready to use.\n# =====================================================================================\nW = {\"occasion\": 0.35, \"voice\": 0.25, \"format\": 0.10, \"palette\": 0.05, \"text\": 0.25}    # importance of each signal\n\n# TF-IDF: converts text into numbers where rare, informative words count more than common ones.\ntfidf = TfidfVectorizer(ngram_range=(1, 2),      # single words and word pairs\n                        sublinear_tf=True,       # damp the effect of repeated words\n                        stop_words=\"english\",    # ignore words like \"the\", \"and\"\n                        min_df=1)\ndoc_matrix = tfidf.fit_transform(library[\"doc_text\"])        # one numeric vector per library example\nRET = {\"vectorizer\": tfidf, \"doc_matrix\": doc_matrix, \"library\": library, \"weights\": W}   # bundle everything together\nprint(\"TF-IDF vocabulary size:\", len(tfidf.vocabulary_), \"| matrix shape:\", doc_matrix.shape)\n\ndef score_examples(query, ret=RET, exclude_idx=None, exclude_business=None):\n    \"\"\"Give every library example a similarity score (0-1) to the query brief.\"\"\"\n    lib = ret[\"library\"]; w = ret[\"weights\"]\n    total = np.zeros(len(lib)); used = 0.0\n    # exact-match signals: add the weight where the example's field equals the requested value\n    for key, col, wk in [(\"occasion\", \"occasion\", \"occasion\"), (\"brand_voice\", \"brand_voice\", \"voice\"),\n                         (\"format\", \"format\", \"format\"), (\"brand_palette\", \"brand_palette\", \"palette\")]:\n        if query.get(key):\n            total += w[wk] * (lib[col].values == query[key]); used += w[wk]\n    # text signal: how similar is the business description to each example's text?\n    if query.get(\"business_text\"):\n        q = ret[\"vectorizer\"].transform([query[\"business_text\"].lower()])\n        total += w[\"text\"] * cosine_similarity(q, ret[\"doc_matrix\"]).ravel(); used += w[\"text\"]\n    score = total / used if used > 0 else total       # rescale so missing fields do not lower the score\n    if exclude_idx is not None:      score[exclude_idx] = -1                                   # used only for testing\n    if exclude_business is not None: score[(lib[\"business_type\"].values == exclude_business)] = -1   # used only for testing\n    return score\n\ndef retrieve_examples(query, k=3, max_per_business=1, ret=RET, exclude_idx=None, exclude_business=None):\n    \"\"\"Return the k best-matching examples, with at most `max_per_business` from the same business type (for variety).\"\"\"\n    lib = ret[\"library\"]\n    score = score_examples(query, ret, exclude_idx, exclude_business)\n    order = np.argsort(-score, kind=\"stable\")          # best first\n    picked, count = [], {}\n    for i in order:\n        if score[i] < 0: break                          # excluded rows are marked -1\n        b = lib.at[i, \"business_type\"]\n        if count.get(b, 0) >= max_per_business: continue   # diversity rule\n        picked.append(i); count[b] = count.get(b, 0) + 1\n        if len(picked) == k: break\n    out = lib.loc[picked, [\"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\",\n                           \"hashtags_clean\", \"cta_clean\", \"image_prompt\"]].copy()\n    out.insert(0, \"score\", score[picked].round(3))\n    return out\nprint(\"Retriever ready.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:34:57.532708Z","iopub.execute_input":"2026-10-04T03:34:57.532988Z","iopub.status.idle":"2026-10-04T03:34:57.67748Z","shell.execute_reply.started":"2026-10-04T03:34:57.532966Z","shell.execute_reply":"2026-10-04T03:34:57.676522Z"}},"outputs":[{"name":"stdout","text":"TF-IDF vocabulary size: 21754 | matrix shape: (1438, 21754)\nRetriever ready.\n","output_type":"stream"}],"execution_count":136},{"cell_type":"code","source":"# =====================================================================================\n# CELL 11 - TRY THE RETRIEVER ON AN EXAMPLE\n# PURPOSE : Show what a retrieval result looks like.\n# QUERY   : \"a bakery wanting a friendly feed post for its grand opening\"\n# CHECK   : Every result should be a \"grand opening\" feed post in a \"warm and friendly\" voice.\n# =====================================================================================\ndemo_query = {\"business_text\": \"bakery fresh bread pastries\", \"brand_voice\": \"warm and friendly\",\n              \"occasion\": \"grand opening\", \"format\": \"feed post\"}\nres = retrieve_examples(demo_query, k=3)\ndisplay(res[[\"score\", \"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\", \"cta_clean\"]])\nfor _, r in res.iterrows():\n    print(f\"[{r['score']}] {r['business_type']}: {r['caption_clean']}  | #{' #'.join(r['hashtags_clean'].split())}  | CTA: {r['cta_clean']}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:34:57.678958Z","iopub.execute_input":"2026-10-04T03:34:57.679683Z","iopub.status.idle":"2026-10-04T03:34:57.701063Z","shell.execute_reply.started":"2026-10-04T03:34:57.679652Z","shell.execute_reply":"2026-10-04T03:34:57.700189Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"     score     business_type        brand_voice       occasion     format  \\\n115  0.737   organic grocery  warm and friendly  grand opening  feed post   \n837  0.737  vegan restaurant  warm and friendly  grand opening  feed post   \n154  0.632   accounting firm  warm and friendly  grand opening      story   \n\n                                        caption_clean  \\\n115         Celebrate with us on our grand opening! 🎉   \n837  Celebrate the opening of our new vegan oasis! 🌼🌱   \n154  Join the celebration at [Brand]'s grand opening!   \n\n                          cta_clean  \n115                  Visit Us Today  \n837  Join us for the grand opening!  \n154                       Visit us!  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>score</th>\n      <th>business_type</th>\n      <th>brand_voice</th>\n      <th>occasion</th>\n      <th>format</th>\n      <th>caption_clean</th>\n      <th>cta_clean</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>115</th>\n      <td>0.737</td>\n      <td>organic grocery</td>\n      <td>warm and friendly</td>\n      <td>grand opening</td>\n      <td>feed post</td>\n      <td>Celebrate with us on our grand opening! 🎉</td>\n      <td>Visit Us Today</td>\n    </tr>\n    <tr>\n      <th>837</th>\n      <td>0.737</td>\n      <td>vegan restaurant</td>\n      <td>warm and friendly</td>\n      <td>grand opening</td>\n      <td>feed post</td>\n      <td>Celebrate the opening of our new vegan oasis! 🌼🌱</td>\n      <td>Join us for the grand opening!</td>\n    </tr>\n    <tr>\n      <th>154</th>\n      <td>0.632</td>\n      <td>accounting firm</td>\n      <td>warm and friendly</td>\n      <td>grand opening</td>\n      <td>story</td>\n      <td>Join the celebration at [Brand]'s grand opening!</td>\n      <td>Visit us!</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"[0.737] organic grocery: Celebrate with us on our grand opening! 🎉  | #luxurygrocery #freshnessinbaskets #goldandcream #grandopening  | CTA: Visit Us Today\n[0.737] vegan restaurant: Celebrate the opening of our new vegan oasis! 🌼🌱  | #veganoasis #plantbasedopening #ecofriendly #foodieevent  | CTA: Join us for the grand opening!\n[0.632] accounting firm: Join the celebration at [Brand]'s grand opening!  | #welcometo #accounting #trustedadvice #monochrome  | CTA: Visit us!\n","output_type":"stream"}],"execution_count":137},{"cell_type":"code","source":"# =====================================================================================\n# CELL 12 - EVALUATE THE RETRIEVER\n# WHY THESE METRICS: Accuracy/R2 do not apply because nothing is predicted. For a retrieval\n#           library the question is \"does it return examples that fit the brief?\".\n# TESTS   : A. Seen business   - the example itself is hidden, its business type is still in the library.\n#           B. UNSEEN business - ALL rows of that business type are hidden. This imitates a new customer\n#              (like civil works) that the dataset has never seen. The most important test.\n#           C. Random baseline - 3 random examples, to show the scores are meaningful.\n#           D. Plain-English descriptions - can free text alone find the right business type?\n#           E. Diversity       - are the 3 results from different business types?\n# HONEST NOTE: occasion/voice matching is partly BY DESIGN (we search on those fields), so the number to\n#           look at is how much higher A/B are than the random baseline, and that B stays close to A.\n# =====================================================================================\nlib = RET[\"library\"]; K = 3\n\ndef match_rates(pred_idx_lists, truth_rows):\n    \"\"\"Average share of retrieved examples whose occasion/voice/format equal the requested ones.\"\"\"\n    occ = voi = fmt = allm = 0\n    for idxs, t in zip(pred_idx_lists, truth_rows):\n        got = lib.loc[idxs]\n        occ  += (got[\"occasion\"] == t[\"occasion\"]).mean()\n        voi  += (got[\"brand_voice\"] == t[\"brand_voice\"]).mean()\n        fmt  += (got[\"format\"] == t[\"format\"]).mean()\n        allm += ((got[\"occasion\"] == t[\"occasion\"]) & (got[\"brand_voice\"] == t[\"brand_voice\"]) & (got[\"format\"] == t[\"format\"])).mean()\n    n = len(truth_rows)\n    return occ / n, voi / n, fmt / n, allm / n\n\ndef top_idx(query, **kw):                       # row numbers of the top-K scoring examples\n    s = score_examples(query, **kw)\n    return list(np.argsort(-s, kind=\"stable\")[:K])\n\nrng = np.random.RandomState(SEED)\nsample_rows = lib.sample(500, random_state=SEED)        # 500 test briefs taken from the library\ntruths = [r for _, r in sample_rows.iterrows()]\n\ndef make_query(r):                                       # turn a library row into a search query\n    return {\"business_text\": r[\"business_type\"], \"brand_voice\": r[\"brand_voice\"], \"occasion\": r[\"occasion\"],\n            \"format\": r[\"format\"], \"brand_palette\": r[\"brand_palette\"]}\n\nres_rows = []\nseen = [top_idx(make_query(r), exclude_idx=i) for i, r in sample_rows.iterrows()]\nres_rows.append((\"A. Seen business type (leave the post itself out)\",) + match_rates(seen, truths))\nunseen = [top_idx(make_query(r), exclude_business=r[\"business_type\"]) for _, r in sample_rows.iterrows()]\nres_rows.append((\"B. UNSEEN business type (whole business removed)\",) + match_rates(unseen, truths))\nrand = [list(rng.choice(len(lib), K, replace=False)) for _ in truths]\nres_rows.append((\"C. Random baseline (3 random examples)\",) + match_rates(rand, truths))\n\ntable = pd.DataFrame(res_rows, columns=[\"test\", \"occasion match\", \"voice match\", \"format match\", \"all three match\"]).set_index(\"test\").round(3)\nprint(\"=== Retrieval quality (top-3, 500 test briefs) ===\"); display(table)\n\nprint(\"\\n=== D. Business-type retrieval from a plain-English description (no categories given) ===\")\nparaphrase = {\"bakery\": \"fresh bread cakes and pastries shop\", \"dental clinic\": \"teeth cleaning dentist smile care\",\n              \"fitness gym\": \"weights workout training membership\", \"florist\": \"flowers bouquets blooms delivery\",\n              \"car wash\": \"cars cleaning shine wash\", \"law firm\": \"legal advice lawyers court\",\n              \"hair salon\": \"haircut styling colour stylist\", \"yoga studio\": \"yoga classes mindfulness stretching\",\n              \"pet grooming salon\": \"dog grooming pets fur\", \"wedding planner\": \"weddings bride event planning\"}\nhits = 0\nfor true_b, text in paraphrase.items():\n    got = retrieve_examples({\"business_text\": text}, k=3, max_per_business=3)[\"business_type\"].tolist()\n    hit = true_b in got; hits += hit\n    print(f\"  {true_b:20s} <- '{text[:34]:34s}' -> {got} {'OK' if hit else 'MISS'}\")\nprint(f\"Hit@3 on paraphrased descriptions: {hits}/{len(paraphrase)}  (10 hand-written descriptions: a small sanity check, not a benchmark)\")\n\nprint(\"\\n=== E. Diversity of the 3 retrieved examples ===\")\ndiv  = [lib.loc[top_idx(make_query(r))][\"business_type\"].nunique() for _, r in sample_rows.head(200).iterrows()]\nprint(\"Average distinct business types among 3 results (before diversity rule):\", round(np.mean(div), 2))\ndiv2 = [retrieve_examples(make_query(r), k=3)[\"business_type\"].nunique() for _, r in sample_rows.head(200).iterrows()]\nprint(\"Average distinct business types among 3 results (with diversity rule)  :\", round(np.mean(div2), 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:34:57.702309Z","iopub.execute_input":"2026-10-04T03:34:57.702646Z","iopub.status.idle":"2026-10-04T03:35:04.060747Z","shell.execute_reply.started":"2026-10-04T03:34:57.702615Z","shell.execute_reply":"2026-10-04T03:35:04.059599Z"}},"outputs":[{"name":"stdout","text":"=== Retrieval quality (top-3, 500 test briefs) ===\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                                                   occasion match  \\\ntest                                                                \nA. Seen business type (leave the post itself out)           1.000   \nB. UNSEEN business type (whole business removed)            1.000   \nC. Random baseline (3 random examples)                      0.055   \n\n                                                   voice match  format match  \\\ntest                                                                           \nA. Seen business type (leave the post itself out)        0.993         0.911   \nB. UNSEEN business type (whole business removed)         0.991         0.905   \nC. Random baseline (3 random examples)                   0.117         0.495   \n\n                                                   all three match  \ntest                                                                \nA. Seen business type (leave the post itself out)            0.904  \nB. UNSEEN business type (whole business removed)             0.897  \nC. Random baseline (3 random examples)                       0.004  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>occasion match</th>\n      <th>voice match</th>\n      <th>format match</th>\n      <th>all three match</th>\n    </tr>\n    <tr>\n      <th>test</th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>A. Seen business type (leave the post itself out)</th>\n      <td>1.000</td>\n      <td>0.993</td>\n      <td>0.911</td>\n      <td>0.904</td>\n    </tr>\n    <tr>\n      <th>B. UNSEEN business type (whole business removed)</th>\n      <td>1.000</td>\n      <td>0.991</td>\n      <td>0.905</td>\n      <td>0.897</td>\n    </tr>\n    <tr>\n      <th>C. Random baseline (3 random examples)</th>\n      <td>0.055</td>\n      <td>0.117</td>\n      <td>0.495</td>\n      <td>0.004</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n=== D. Business-type retrieval from a plain-English description (no categories given) ===\n  bakery               <- 'fresh bread cakes and pastries sho' -> ['bakery', 'bakery', 'bakery'] OK\n  dental clinic        <- 'teeth cleaning dentist smile care ' -> ['dental clinic', 'dental clinic', 'car wash'] OK\n  fitness gym          <- 'weights workout training membershi' -> ['fitness gym', 'fitness gym', 'fitness gym'] OK\n  florist              <- 'flowers bouquets blooms delivery  ' -> ['florist', 'florist', 'florist'] OK\n  car wash             <- 'cars cleaning shine wash          ' -> ['car wash', 'car wash', 'car wash'] OK\n  law firm             <- 'legal advice lawyers court        ' -> ['law firm', 'law firm', 'accounting firm'] OK\n  hair salon           <- 'haircut styling colour stylist    ' -> ['hair salon', 'hair salon', 'hair salon'] OK\n  yoga studio          <- 'yoga classes mindfulness stretchin' -> ['yoga studio', 'yoga studio', 'yoga studio'] OK\n  pet grooming salon   <- 'dog grooming pets fur             ' -> ['pet grooming salon', 'pet grooming salon', 'pet grooming salon'] OK\n  wedding planner      <- 'weddings bride event planning     ' -> ['wedding planner', 'wedding planner', 'wedding planner'] OK\nHit@3 on paraphrased descriptions: 10/10  (10 hand-written descriptions: a small sanity check, not a benchmark)\n\n=== E. Diversity of the 3 retrieved examples ===\nAverage distinct business types among 3 results (before diversity rule): 2.74\nAverage distinct business types among 3 results (with diversity rule)  : 3.0\n","output_type":"stream"}],"execution_count":138},{"cell_type":"code","source":"# =====================================================================================\n# CELL 13A - DEFINE THE USER'S MARKETING BRIEF (+ check it against the dataset's vocabulary)\n# PURPOSE : Represent what a real business user types into the website.\n# WHY     : These fields drive the caption, hashtags, CTA, content idea and image prompt.\n#           TARGET CUSTOMER, SERVICE, GOAL and LOCATION come from the USER (Dataset 5 has no civil-works knowledge).\n# IMPORTANT CHECK: Dataset 5 stores voices, occasions, formats and palettes in lowercase (e.g. \"before and after\").\n#           We compare the brief with those allowed values, so a mismatch is reported instead of silently\n#           returning unrelated examples.\n# =====================================================================================\nmarketing_brief = {\n    \"business_type\":   \"Civil Works Company\",\n    \"service\":         \"Bathroom Renovation\",\n    \"target_customer\": \"Homeowners\",\n    \"platform\":        \"Instagram\",\n    \"marketing_goal\":  \"Generate Enquiries\",\n    \"brand_voice\":     \"Professional and Trustworthy\",\n    \"location\":        \"Chennai\",\n    \"content_format\":  \"Feed Post\",\n    \"occasion\":        \"Before and After\",\n    \"brand_palette\":   \"Muted Neutrals\",\n}\nprint(\"Marketing brief created successfully.\\n\")\nfor key, value in marketing_brief.items():\n    print(f\"{key}: {value}\")\n\n# The values Dataset 5 knows about, per field. (brief field -> library column)\nVOCAB = {\"brand_voice\": set(library[\"brand_voice\"]), \"occasion\": set(library[\"occasion\"]),\n         \"format\": set(library[\"format\"]), \"brand_palette\": set(library[\"brand_palette\"])}\nBRIEF_TO_LIB = {\"brand_voice\": \"brand_voice\", \"occasion\": \"occasion\",\n                \"content_format\": \"format\", \"brand_palette\": \"brand_palette\"}\n\ndef check_brief_vocabulary(brief):\n    \"\"\"Report which brief fields can be matched exactly against Dataset 5 (case-insensitive).\"\"\"\n    print(\"\\n--- Vocabulary check (can the dataset match these exactly?) ---\")\n    for brief_key, lib_col in BRIEF_TO_LIB.items():\n        value = str(brief.get(brief_key, \"\")).strip().lower()\n        if value in VOCAB[lib_col]:\n            print(f\"  OK       {brief_key:14s} = '{value}'\")\n        else:\n            print(f\"  NOT FOUND {brief_key:13s} = '{value}'  -> ignored for matching. Allowed: {sorted(VOCAB[lib_col])}\")\ncheck_brief_vocabulary(marketing_brief)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:35:04.061907Z","iopub.execute_input":"2026-10-04T03:35:04.062223Z","iopub.