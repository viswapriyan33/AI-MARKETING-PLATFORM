Store everything the backend (FastAPI) needs, in portable formats.\n","# FILES   : social_library_clean.csv     - the clean example library\n","#           social_retriever.joblib      - fitted TF-IDF vectorizer + matrix + weights + allowed values\n","#           platform_rules.json          - writing rules and hashtag limits per platform\n","#           prompt_example_civil_works.txt - the prompt built in Cell 13C\n","#           model_card.json              - short description of method and limits\n","# CHECK   : Reloads the files and confirms the retriever still gives the same top result.\n","# =====================================================================================\n","OUT = \"/kaggle/working\" if os.path.isdir(\"/kaggle/working\") else \"out\"\n","os.makedirs(OUT, exist_ok=True)\n","\n","library.drop(columns=[c for c in library.columns if c.startswith(\"_\")]).to_csv(f\"{OUT}/social_library_clean.csv\", index=False)\n","joblib.dump({\"vectorizer\": RET[\"vectorizer\"], \"doc_matrix\": RET[\"doc_matrix\"], \"weights\": RET[\"weights\"],\n","             \"vocab\": {k: sorted(v) for k, v in VOCAB.items()}, \"library_csv\": \"social_library_clean.csv\"}, f\"{OUT}/social_retriever.joblib\")\n","with open(f\"{OUT}/platform_rules.json\", \"w\") as f: json.dump({\"rules\": PLATFORM_RULES, \"hashtag_limits\": HASHTAG_LIMITS}, f, indent=2)\n","with open(f\"{OUT}/prompt_example_civil_works.txt\", \"w\") as f: f.write(llm_prompt)\n","\n","card = {\"dataset\": \"Social - Instagram Marketing Multimodal Dataset (synthetic)\",\n","        \"role\": \"style-example library for retrieval-augmented prompting (NOT a trained model)\",\n","        \"method\": \"TF-IDF cosine similarity + weighted exact match on occasion/voice/format/palette\",\n","        \"weights\": W, \"library_rows\": int(len(library)),\n","        \"validator\": \"format/count/duplicate/claim checks; semantic relevance left to human approval\",\n","        \"limitations\": [\"synthetic data\", \"Instagram only\", \"no civil-works examples\", \"no engagement data\", \"image files not bundled with CSV\"]}\n","with open(f\"{OUT}/model_card.json\", \"w\") as f: json.dump(card, f, indent=2)\n","print(\"Saved:\", sorted(os.listdir(OUT)))\n","\n","# Reload test: rebuild the retriever ONLY from the saved files, as the backend would\n","saved = joblib.load(f\"{OUT}/social_retriever.joblib\")\n","lib2  = pd.read_csv(f\"{OUT}/{saved['library_csv']}\")\n","ret2  = {\"vectorizer\": saved[\"vectorizer\"], \"doc_matrix\": saved[\"doc_matrix\"], \"library\": lib2, \"weights\": saved[\"weights\"]}\n","before = retrieve_examples(query_used, k=3)\n","after  = retrieve_examples(query_used, k=3, ret=ret2)\n","print(\"\\nReload test - same top result as before?\", before.iloc[0][\"caption_clean\"] == after.iloc[0][\"caption_clean\"])\n","\n"]},{"cell_type":"code","execution_count":23,"id":"56a89f95","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:49:06.477774Z","iopub.status.busy":"2026-10-07T04:49:06.477397Z","iopub.status.idle":"2026-10-07T04:49:06.485545Z","shell.execute_reply":"2026-10-07T04:49:06.484644Z"},"papermill":{"duration":0.02272,"end_time":"2026-10-07T04:49:06.487716+00:00","exception":false,"start_time":"2026-10-07T04:49:06.464996+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["========================================================================\n","FINAL INTERPRETATION - DATASET 5\n","========================================================================\n","Usable examples in the library      : 1438 of 1447\n","Seen business, top-3 all-three match : 90.4%\n","UNSEEN business, top-3 all-three match: 89.7%\n","Random baseline, all-three match      : 0.4%\n","Dataset audit pass rate raw -> cleaned: 35.7% -> 99.3%\n","\n","VERDICT\n","  - Dataset 5 is NOT used to train or fine-tune a model.\n","  - Flow: user brief (target customer, service, goal, location) -> retrieve 3 style examples -> LLM prompt -> LLM -> validator -> human approval.\n","  - Civil-works facts come from the user's brief; Dataset 5 supplies structure and style only.\n","  - Hashtag relevance is judged by the LLM prompt and the human reviewer; the validator checks format, count and duplicates.\n","  - No engagement claims can be made from this dataset.\n"]}],"source":["## Cell 17: Final interpretation\n","# =====================================================================================\n","# CELL 17 - FINAL INTERPRETATION\n","# PURPOSE : Print the key numbers and the conclusion in one place for the report.\n","# =====================================================================================\n","print(\"=\" * 72); print(\"FINAL INTERPRETATION - DATASET 5\"); print(\"=\" * 72)\n","print(f\"Usable examples in the library      : {len(library)} of {len(df)}\")\n","print(f\"Seen business, top-3 all-three match : {table.loc[table.index[0], 'all three match']:.1%}\")\n","print(f\"UNSEEN business, top-3 all-three match: {table.loc[table.index[1], 'all three match']:.1%}\")\n","print(f\"Random baseline, all-three match      : {table.loc[table.index[2], 'all three match']:.1%}\")\n","print(f\"Dataset audit pass rate raw -> cleaned: {raw_pass.mean():.1%} -> {clean_pass.mean():.1%}\")\n","print(\"\\nVERDICT\")\n","print(\"  - Dataset 5 is NOT used to train or fine-tune a model.\")\n","print(\"  - Flow: user brief (target customer, service, goal, location) -> retrieve 3 style examples -> LLM prompt -> LLM -> validator -> human approval.\")\n","print(\"  - Civil-works facts come from the user's brief; Dataset 5 supplies structure and style only.\")\n","print(\"  - Hashtag relevance is judged by the LLM prompt and the human reviewer; the validator checks format, count and duplicates.\")\n","print(\"  - No engagement claims can be made from this dataset.\")\n","\n","\n"]},{"cell_type":"code","execution_count":24,"id":"25bd8ee4","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:49:06.512082Z","iopub.status.busy":"2026-10-07T04:49:06.511561Z","iopub.status.idle":"2026-10-07T04:49:06.996187Z","shell.execute_reply":"2026-10-07T04:49:06.99532Z"},"papermill":{"duration":0.499421,"end_time":"2026-10-07T04:49:06.998195+00:00","exception":false,"start_time":"2026-10-07T04:49:06.498774+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["--- 1. LOADING DATASET ---\n","Loaded shape: (1447, 12)\n","\n","--- 2. CLEANING & PREPARING LIBRARY ---\n","Library size after quality filter: 1438\n","\n","--- 3. BUILDING TF-IDF RETRIEVER ---\n","\n","--- 4. PROMPT BUILDER & VALIDATORS ---\n","\n","--- 5. RUNNING END-TO-END TEST DEMO ---\n","Retrieved 3 examples successfully.\n","Sample prompt generated successfully (length: 1508 chars).\n","\n","--- 6. SAVING ARTIFACTS ---\n","Pipeline complete! Artifacts saved to: /kaggle/working\n"]}],"source":["# =====================================================================================\n","# DATASET 5: ALL-IN-ONE AI CONTENT GENERATION & RETRIEVAL PIPELINE\n","# =====================================================================================\n","\n","import os\n","import re\n","import glob\n","import json\n","import random\n","import warnings\n","import numpy as np\n","import pandas as pd\n","import joblib\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","from sklearn.metrics.pairwise import cosine_similarity\n","\n","warnings.filterwarnings(\"ignore\")\n","SEED = 42\n","random.seed(SEED)\n","np.random.seed(SEED)\n","\n","print(\"--- 1. LOADING DATASET ---\")\n","def find_dataset_csv():\n","    hits = glob.glob(\"/kaggle/input/**/social_dataset.csv\", recursive=True)\n","    if hits:\n","        return hits[0]\n","    try:\n","        from huggingface_hub import hf_hub_download\n","        return hf_hub_download(repo_id=\"avihayamor/social-instagram-marketing\", filename=\"social_dataset.csv\", repo_type=\"dataset\")\n","    except Exception as e:\n","        raise FileNotFoundError(\"social_dataset.csv not found. Details: \" + repr(e))\n","\n","DATA_FILE = find_dataset_csv()\n","df = pd.read_csv(DATA_FILE)\n","print(f\"Loaded shape: {df.shape}\")\n","\n","print(\"\\n--- 2. CLEANING & PREPARING LIBRARY ---\")\n","def clean_hashtags(h):\n","    tags = [t.lower() for t in re.findall(r\"[A-Za-z0-9_]+\", str(h))]\n","    seen, out = set(), []\n","    for t in tags:\n","        if t not in seen:\n","            seen.add(t)\n","            out.append(t)\n","    return out\n","\n","def clean_caption(c):\n","    c = re.sub(r\"#\\w+\", \"\", str(c))\n","    return re.sub(r\"\\s+\", \" \", c).strip()\n","\n","df[\"hashtag_list\"] = df[\"hashtags\"].map(clean_hashtags)\n","df[\"hashtags_clean\"] = df[\"hashtag_list\"].map(lambda L: \" \".join(L))\n","df[\"hashtag_count\"] = df[\"hashtag_list\"].map(len)\n","\n","df[\"caption_clean\"] = df[\"caption\"].map(clean_caption)\n","df[\"caption_words\"] = df[\"caption_clean\"].map(lambda s: len(s.split()))\n","\n","df[\"cta_clean\"] = df[\"cta\"].astype(str).str.strip()\n","df[\"cta_key\"] = df[\"cta_clean\"].str.lower().str.replace(r\"[^\\w\\s]\", \"\", regex=True).str.strip()\n","\n","# Quality filter flag\n","df[\"quality_ok\"] = (df[\"caption_words\"] >= 4) & (df[\"hashtag_count\"] >= 2) & (df[\"cta_key\"].str.len() > 0)\n","\n","# Searchable text\n","df[\"doc_text\"] = (df[\"business_type\"] + \" \" + df[\"occasion\"] + \" \" + df[\"hashtags_clean\"] + \" \" + df[\"caption_clean\"] + \" \" + df[\"image_prompt\"].astype(str)).str.lower()\n","\n","library = df[df[\"quality_ok\"]].reset_index(drop=True)\n","print(f\"Library size after quality filter: {len(library)}\")\n","\n","print(\"\\n--- 3. BUILDING TF-IDF RETRIEVER ---\")\n","W = {\"occasion\": 0.35, \"voice\": 0.25, \"format\": 0.10, \"palette\": 0.05, \"text\": 0.25}\n","\n","tfidf = TfidfVectorizer(ngram_range=(1, 2), sublinear_tf=True, stop_words=\"english\", min_df=1)\n","doc_matrix = tfidf.fit_transform(library[\"doc_text\"])\n","\n","VOCAB = {\n","    \"brand_voice\": set(library[\"brand_voice\"]),\n","    \"occasion\": set(library[\"occasion\"]),\n","    \"format\": set(library[\"format\"]),\n","    \"brand_palette\": set(library[\"brand_palette\"])\n","}\n","BRIEF_TO_LIB = {\n","    \"brand_voice\": \"brand_voice\",\n","    \"occasion\": \"occasion\",\n","    \"content_format\": \"format\",\n","    \"brand_palette\": \"brand_palette\"\n","}\n","\n","RET = {\"vectorizer\": tfidf, \"doc_matrix\": doc_matrix, \"library\": library, \"weights\": W}\n","\n","def score_examples(query, ret=RET, exclude_idx=None, exclude_business=None):\n","    lib = ret[\"library\"]\n","    w = ret[\"weights\"]\n","    total = np.zeros(len(lib))\n","    used = 0.0\n","    \n","    for key, col, wk in [(\"occasion\", \"occasion\", \"occasion\"), \n","                         (\"brand_voice\", \"brand_voice\", \"voice\"), \n","                         (\"format\", \"format\", \"format\"), \n","                         (\"brand_palette\", \"brand_palette\", \"palette\")]:\n","        if query.get(key):\n","            total += w[wk] * (lib[col].values == query[key])\n","            used += w[wk]\n","            \n","    if query.get(\"business_text\"):\n","        q = ret[\"vectorizer\"].transform([query[\"business_text\"].lower()])\n","        total += w[\"text\"] * cosine_similarity(q, ret[\"doc_matrix\"]).ravel()\n","        used += w[\"text\"]\n","        \n","    score = total / used if used > 0 else total\n","    if exclude_idx is not None:\n","        score[exclude_idx] = -1\n","    if exclude_business is not None:\n","        score[(lib[\"business_type\"].values == exclude_business)] = -1\n","    return score\n","\n","def retrieve_examples(query, k=3, max_per_business=1, ret=RET, exclude_idx=None, exclude_business=None):\n","    lib = ret[\"library\"]\n","    score = score_examples(query, ret, exclude_idx, exclude_business)\n","    order = np.argsort(-score, kind=\"stable\")\n","    \n","    picked, count = [], {}\n","    for i in order:\n","        if score[i] < 0:\n","            break\n","        b = lib.at[i, \"business_type\"]\n","        if count.get(b, 0) >= max_per_business:\n","            continue\n","        picked.append(i)\n","        count[b] = count.get(b, 0) + 1\n","        if len(picked) == k:\n","            break\n","            \n","    out = lib.loc[picked, [\"business_type\", \"brand_voice\", \"occasion\", \"format\", \"caption_clean\", \"hashtags_clean\", \"cta_clean\", \"image_prompt\"]].copy()\n","    out.insert(0, \"score\", score[picked].round(3))\n","    return out\n","\n","print(\"\\n--- 4. PROMPT BUILDER & VALIDATORS ---\")\n","HASHTAG_LIMITS = {\"Instagram\": (5, 10), \"Facebook\": (1, 3), \"LinkedIn\": (1, 3)}\n","PLATFORM_RULES = {\n","    \"Instagram\": \"Short, punchy caption (about 8-40 words). Emojis allowed in moderation. Hashtags go ONLY in the hashtags field.\",\n","    \"Facebook\": \"Conversational caption of 1-3 sentences.\",\n","    \"LinkedIn\": \"Professional caption of 2-4 sentences, minimal emojis.\"\n","}\n","\n","def brief_to_query(brief):\n","    text = \" \".join(str(brief.get(k, \"\")) for k in [\"business_type\", \"service\", \"target_customer\", \"marketing_goal\", \"location\"])\n","    query = {\"business_text\": text}\n","    for brief_key, lib_col in BRIEF_TO_LIB.items():\n","        value = str(brief.get(brief_key, \"\")).strip().lower()\n","        if value in VOCAB[lib_col]:\n","            query[lib_col] = value\n","    return query\n","\n","def build_llm_prompt(brief, examples_df):\n","    platform = brief.get(\"platform\", \"Instagram\")\n","    lo, hi = HASHTAG_LIMITS.get(platform, (3, 8))\n","    \n","    examples_text = \"\"\n","    for i, (_, ex) in enumerate(examples_df.iterrows(), start=1):\n","        examples_text += (f\"\\n--- Example {i} (style reference from ANOTHER business) ---\\n\"\n","                          f\"Business Type: {ex['business_type']}\\n\"\n","                          f\"Brand Voice: {ex['brand_voice']}\\n\"\n","                          f\"Format: {ex['format']}\\n\"\n","                          f\"Occasion: {ex['occasion']}\\n\"\n","                          f\"Caption: {ex['caption_clean']}\\n\"\n","                          f\"Hashtags: {ex['hashtags_clean']}\\n\"\n","                          f\"CTA: {ex['cta_clean']}\\n\")\n","                          \n","    return f\"\"\"You are an AI marketing content assistant. Create social-media marketing content for a business using the information below.\n","RULES:\n","1. Generate {lo} to {hi} relevant hashtags each starting with '#', no spaces, no duplicates.\n","2. No '#' symbols inside the caption.\n","3. Return ONLY valid JSON containing keys: caption, hashtags, cta, content_idea, image_prompt.\n","\n","BUSINESS INFO:\n","Business Type: {brief.get('business_type')}\n","Service: {brief.get('service')}\n","Target Customer: {brief.get('target_customer')}\n","Platform: {platform}\n","Marketing Goal: {brief.get('marketing_goal')}\n","Brand Voice: {brief.get('brand_voice')}\n","Location: {brief.get('location')}\n","\n","RETRIEVED EXAMPLES:\n","{examples_text}\n","\"\"\"\n","\n","def parse_llm_json(text):\n","    t = re.sub(r\"^```(?:json)?\\s*|\\s*```$\", \"\", text.strip())\n","    start, end = t.find(\"{\"), t.rfind(\"}\")\n","    return json.loads(t[start:end + 1])\n","\n","def validate_hashtags(hashtags, platform=\"Instagram\", min_count=None, max_count=None):\n","    issues = []\n","    if not isinstance(hashtags, list):\n","        return [\"Hashtags must be returned as a list.\"]\n","    lo, hi = HASHTAG_LIMITS.get(platform, (3, 8))\n","    lo = lo if min_count is None else min_count\n","    hi = hi if max_count is None else max_count\n","    \n","    if len(hashtags) < lo:\n","        issues.append(f\"Too few hashtags ({len(hashtags)}; need at least {lo}).\")\n","    if len(hashtags) > hi:\n","        issues.append(f\"Too many hashtags ({len(hashtags)}; at most {hi}).\")\n","        \n","    cleaned = []\n","    for tag in hashtags:\n","        if not isinstance(tag, str):\n","            issues.append(\"A hashtag is not a string.\")\n","            continue\n","        tag = tag.strip()\n","        if not re.fullmatch(r\"#\\w+\", tag):\n","            issues.append(f\"Invalid hashtag format: '{tag}'\")\n","        cleaned.append(tag.lower())\n","        \n","    if len(cleaned) != len(set(cleaned)):\n","        issues.append(\"Duplicate hashtags found.\")\n","    return issues\n","\n","print(\"\\n--- 5. RUNNING END-TO-END TEST DEMO ---\")\n","marketing_brief = {\n","    \"business_type\": \"Civil Works Company\",\n","    \"service\": \"Bathroom Renovation\",\n","    \"target_customer\": \"Homeowners\",\n","    \"platform\": \"Instagram\",\n","    \"marketing_goal\": \"Generate Enquiries\",\n","    \"brand_voice\": \"professional and trustworthy\",\n","    \"location\": \"Chennai\",\n","    \"content_format\": \"feed post\",\n","    \"occasion\": \"before and after\",\n","    \"brand_palette\": \"muted neutrals\"\n","}\n","\n","query = brief_to_query(marketing_brief)\n","retrieved = retrieve_examples(query, k=3)\n","prompt = build_llm_prompt(marketing_brief, retrieved)\n","\n","print(f\"Retrieved {len(retrieved)} examples successfully.\")\n","print(\"Sample prompt generated successfully (length:\", len(prompt), \"chars).\")\n","\n","print(\"\\n--- 6. SAVING ARTIFACTS ---\")\n","OUT = \"/kaggle/working\" if os.path.isdir(\"/kaggle/working\") else \"out\"\n","os.makedirs(OUT, exist_ok=True)\n","\n","library.drop(columns=[c for c in library.columns if c.startswith(\"_\")]).to_csv(f\"{OUT}/social_library_clean.csv\", index=False)\n","joblib.dump({\n","    \"vectorizer\": RET[\"vectorizer\"],\n","    \"doc_matrix\": RET[\"doc_matrix\"],\n","    \"weights\": RET[\"weights\"],\n","    \"vocab\": {k: sorted(v) for k, v in VOCAB.items()},\n","    \"library_csv\": \"social_library_clean.csv\"\n","}, f\"{OUT}/social_retriever.joblib\")\n