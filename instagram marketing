=========================\n# CELL 13C - BUILD THE TARGET-CUSTOMER-AWARE LLM PROMPT\n# PURPOSE : Combine the user's brief and the retrieved examples into one instruction for any LLM.\n# KEY IDEA: The prompt tells the LLM that TARGET CUSTOMER, SERVICE, PLATFORM, GOAL and LOCATION must shape the\n#           caption, hashtags and CTA, while the retrieved examples are used ONLY for style (not copied).\n# HASHTAG COUNT depends on the platform (Instagram 5-10, Facebook/LinkedIn 1-3), defined once in HASHTAG_LIMITS and reused by the validator.\n# =====================================================================================\nHASHTAG_LIMITS = {\"Instagram\": (5, 10), \"Facebook\": (1, 3), \"LinkedIn\": (1, 3)}    # (minimum, maximum)\nPLATFORM_RULES = {\n    \"Instagram\": \"Short, punchy caption (about 8-40 words). Emojis allowed in moderation. Hashtags go ONLY in the hashtags field.\",\n    \"Facebook\":  \"Conversational caption of 1-3 sentences.\",\n    \"LinkedIn\":  \"Professional caption of 2-4 sentences, minimal emojis.\",\n}\n\ndef build_llm_prompt(brief, examples_df):\n    platform = brief.get(\"platform\", \"Instagram\")\n    lo, hi = HASHTAG_LIMITS.get(platform, (3, 8))\n    # One text block per retrieved example (iterrows gives the rows; looping over the DataFrame directly would give column names)\n    examples_text = \"\"\n    for i, (_, ex) in enumerate(examples_df.iterrows(), start=1):\n        examples_text += (f\"\\n--- Example {i} (style reference from ANOTHER business) ---\\n\"\n                          f\"Business Type: {ex['business_type']}\\nBrand Voice: {ex['brand_voice']}\\nFormat: {ex['format']}\\n\"\n                          f\"Occasion: {ex['occasion']}\\nCaption: {ex['caption_clean']}\\nHashtags: {ex['hashtags_clean']}\\n\"\n                          f\"CTA: {ex['cta_clean']}\\nImage prompt: {ex['image_prompt']}\\n\")\n    return f\"\"\"You are an AI marketing content assistant.\nCreate social-media marketing content for a business using the information below.\n\nIMPORTANT RULES:\n1. The TARGET CUSTOMER must strongly influence the hashtags, caption, CTA and content idea.\n2. The SERVICE must be clearly relevant to the generated content.\n3. The PLATFORM ({platform}) must influence the writing style and hashtag selection. {PLATFORM_RULES.get(platform, \"\")}\n4. The MARKETING GOAL must influence the CTA.\n5. The LOCATION may be used in hashtags when it is relevant.\n6. Use ONLY facts from the business information. Do not invent prices, discounts, awards, certifications, statistics, guarantees, project results or customer reviews.\n7. Do not copy the retrieved examples. They come from other businesses and are only style references.\n8. Generate {lo} to {hi} relevant hashtags, each starting with '#', no spaces, no duplicates.\n9. Hashtags must relate to the target customer, service, platform, goal, or location. Do not add random trending or engagement-bait hashtags.\n10. No '#' symbols inside the caption.\n11. Return ONLY valid JSON.\n\nBUSINESS INFORMATION:\nBusiness Type: {brief.get(\"business_type\", \"\")}\nService: {brief.get(\"service\", \"\")}\nTarget Customer: {brief.get(\"target_customer\", \"\")}\nPlatform: {platform}\nMarketing Goal: {brief.get(\"marketing_goal\", \"\")}\nBrand Voice: {brief.get(\"brand_voice\", \"\")}\nLocation: {brief.get(\"location\", \"\")}\nContent Format: {brief.get(\"content_format\", \"\")}\nOccasion: {brief.get(\"occasion\", \"\")}\nBrand Palette: {brief.get(\"brand_palette\", \"\")}\n\nRETRIEVED MARKETING EXAMPLES (style only):\n{examples_text}\nREQUIRED OUTPUT (JSON):\n{{\n  \"caption\": \"Social media caption\",\n  \"hashtags\": [\"#hashtag1\", \"#hashtag2\", \"#hashtag3\", \"#hashtag4\", \"#hashtag5\"],\n  \"cta\": \"One clear call to action\",\n  \"content_idea\": \"One content idea\",\n  \"image_prompt\": \"Realistic image generation prompt\"\n}}\n\"\"\"\n\nllm_prompt = build_llm_prompt(marketing_brief, retrieved_examples)\nprint(\"LLM prompt created successfully.\")\nprint(\"=\" * 80)\nprint(llm_prompt)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:35:04.117189Z","iopub.execute_input":"2026-10-04T03:35:04.117513Z","iopub.status.idle":"2026-10-04T03:35:04.134624Z","shell.execute_reply.started":"2026-10-04T03:35:04.11749Z","shell.execute_reply":"2026-10-04T03:35:04.133616Z"}},"outputs":[{"name":"stdout","text":"LLM prompt created successfully.\n================================================================================\nYou are an AI marketing content assistant.\nCreate social-media marketing content for a business using the information below.\n\nIMPORTANT RULES:\n1. The TARGET CUSTOMER must strongly influence the hashtags, caption, CTA and content idea.\n2. The SERVICE must be clearly relevant to the generated content.\n3. The PLATFORM (Instagram) must influence the writing style and hashtag selection. Short, punchy caption (about 8-40 words). Emojis allowed in moderation. Hashtags go ONLY in the hashtags field.\n4. The MARKETING GOAL must influence the CTA.\n5. The LOCATION may be used in hashtags when it is relevant.\n6. Use ONLY facts from the business information. Do not invent prices, discounts, awards, certifications, statistics, guarantees, project results or customer reviews.\n7. Do not copy the retrieved examples. They come from other businesses and are only style references.\n8. Generate 5 to 10 relevant hashtags, each starting with '#', no spaces, no duplicates.\n9. Hashtags must relate to the target customer, service, platform, goal, or location. Do not add random trending or engagement-bait hashtags.\n10. No '#' symbols inside the caption.\n11. Return ONLY valid JSON.\n\nBUSINESS INFORMATION:\nBusiness Type: Civil Works Company\nService: Bathroom Renovation\nTarget Customer: Homeowners\nPlatform: Instagram\nMarketing Goal: Generate Enquiries\nBrand Voice: Professional and Trustworthy\nLocation: Chennai\nContent Format: Feed Post\nOccasion: Before and After\nBrand Palette: Muted Neutrals\n\nRETRIEVED MARKETING EXAMPLES (style only):\n\n--- Example 1 (style reference from ANOTHER business) ---\nBusiness Type: wine bar\nBrand Voice: professional and trustworthy\nFormat: feed post\nOccasion: before and after\nCaption: Transform your night with our wines! 🍷🎉\nHashtags: winebar winelove wineflavors nightcap\nCTA: Visit us!\nImage prompt: A wine bar with a selection of vibrant, ocean-colored wine bottles and a glass of wine on the table\n\n--- Example 2 (style reference from ANOTHER business) ---\nBusiness Type: co-working space\nBrand Voice: professional and trustworthy\nFormat: feed post\nOccasion: before and after\nCaption: Transform your workspace with us. Before & after, you'll see a difference.\nHashtags: workspace co_working productivity inspire\nCTA: Learn more now\nImage prompt: Before and after view of a professional co-working space, contrasting old and new\n\n--- Example 3 (style reference from ANOTHER business) ---\nBusiness Type: tech startup\nBrand Voice: professional and trustworthy\nFormat: feed post\nOccasion: before and after\nCaption: Before and after: Our tech revolution 🚀\nHashtags: tech beforeandafter innovation startup\nCTA: Join our journey\nImage prompt: A row of black and white tech gadgets, one with vibrant colors\n\nREQUIRED OUTPUT (JSON):\n{\n  \"caption\": \"Social media caption\",\n  \"hashtags\": [\"#hashtag1\", \"#hashtag2\", \"#hashtag3\", \"#hashtag4\", \"#hashtag5\"],\n  \"cta\": \"One clear call to action\",\n  \"content_idea\": \"One content idea\",\n  \"image_prompt\": \"Realistic image generation prompt\"\n}\n\n","output_type":"stream"}],"execution_count":141},{"cell_type":"code","source":"# =====================================================================================\n# CELL 13D - CHECK THAT THE USER'S INFORMATION REACHES THE PROMPT\n# PURPOSE : Before spending any LLM/API call, confirm every important brief field is present in the prompt text.\n# ALSO    : Builds a SECOND, different brief (property developers) to show the prompt changes with the target customer.\n# =====================================================================================\nrequired_fields = [\"business_type\", \"service\", \"target_customer\", \"platform\", \"marketing_goal\", \"brand_voice\", \"location\"]\n\ndef check_prompt_inputs(brief, prompt):\n    all_ok = True\n    for field in required_fields:\n        value = brief.get(field)\n        if not value:\n            print(f\"X Missing in brief: {field}\"); all_ok = False\n        elif str(value) not in prompt:\n            print(f\"X In brief but NOT in prompt: {field} = {value}\"); all_ok = False\n        else:\n            print(f\"OK {field}: {value}\")\n    return all_ok\n\nprint(\"=== Brief 1 (civil works / homeowners) ===\")\nok1 = check_prompt_inputs(marketing_brief, llm_prompt)\n\nbrief_2 = {\"business_type\": \"Civil Works Company\", \"service\": \"Commercial Construction\", \"target_customer\": \"Property Developers\",\n           \"platform\": \"Instagram\", \"marketing_goal\": \"Generate Enquiries\", \"brand_voice\": \"Professional and Trustworthy\",\n           \"location\": \"Chennai\", \"content_format\": \"Feed Post\", \"occasion\": \"Behind the Scenes\", \"brand_palette\": \"Muted Neutrals\"}\nprompt_2 = build_llm_prompt(brief_2, retrieve_examples(brief_to_query(brief_2), k=3))\nprint(\"\\n=== Brief 2 (commercial construction / property developers) ===\")\nok2 = check_prompt_inputs(brief_2, prompt_2)\n\ndef business_info_lines(prompt):\n    \"\"\"Only the 'BUSINESS INFORMATION' block of a prompt (what the user typed), without the example posts.\"\"\"\n    block = prompt.split(\"BUSINESS INFORMATION:\")[1].split(\"RETRIEVED MARKETING EXAMPLES\")[0]\n    return [l.strip() for l in block.splitlines() if l.strip()]\n\nchanged = [l for l in business_info_lines(prompt_2) if l not in business_info_lines(llm_prompt)]\nprint(\"\\nBusiness-information lines that changed between the two prompts (driven by the user's input):\")\nfor l in changed: print(\"  >\", l)\nprint(\"\\nAll required fields reached both prompts:\", ok1 and ok2)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-04T03:35:04.135785Z","iopub.execute_input":"2026-10-04T03:35:04.136142Z","iopub.status.idle":"2026-10-04T03:35:04.173077Z","shell.execute_reply.started":"2026-10-04T03:35:04.13611Z","shell.execute_reply":"2026-10-04T03:35:04.172049Z"}},"outputs":[{"name":"stdout","text":"=== Brief 1 (civil works / homeowners) ===\nOK business_type: Civil Works Company\nOK service: Bathroom Renovation\nOK target_customer: Homeowners\nOK platform: Instagram\nOK marketing_goal: Generate Enquiries\nOK brand_voice: Professional and Trustworthy\nOK location: Chennai\n\n=== Brief 2 (commercial construction / property developers) ===\nOK business_type: Civil Works Company\nOK service: Commercial Construction\nOK target_customer: Property Developers\nOK platform: Instagram\nOK marketing_goal: Generate Enquiries\nOK brand_voice: Professional and Trustworthy\nOK location: Chennai\n\nBusiness-information lines that changed between the two prompts (driven by the user's input):\n  > Service: Commercial Construction\n  > Target Customer: Property Developers\n  > Occasion: Behind the Scenes\n\nAll required fields reached both prompts: True\n","output_type":"stream"}],"execution_count":142},{"cell_type":"code","source":"# =====================================================================================\n# CELL 14 - VALIDATORS (hashtags + the whole generated post) AND JSON PARSER\n# PURPOSE : Catch mechanical mistakes in the LLM output automatically, before human approval.\n# WHAT IT CHECKS (format, count, duplicates, rules) - it does NOT judge whether a hashtag is semantically relevant.\n#           Relevance (\"#DreamHome\" fits homeowners) is a human judgement, so it stays in the Human Approval step.\n# HASHTAGS: must be a list, within the platform's min-max count, each written '#word' (no spaces), no duplicates,\n#           and not engagement-bait such as #followforfollow.\n# POST    : also checks required JSON keys, caption length, no '#' inside the caption, a CTA, image prompt, content idea,\n#           possible invented claims (guarantee, 100%, free, prices...) and copying from the library.\n# =====================================================================================\nSPAM_HASHTAGS = {\"followforfollow\", \"follow4follow\", \"f4f\", \"like4like\", \"likeforlike\", \"l4l\", \"followback\", \"tagsforlikes\", \"likesforlikes\"}\nREQUIRED_KEYS = [\"caption\", \"hashtags\", \"cta\", \"content_idea\", \"image_prompt\"]\nCLAIM_PATTERNS = [r\"\\bguarantee[sd]?\\b\", r\"\\b100\\s?%\", r\"\\b#?1\\b.*\\b(best|rated|choice)\\b\", r\"\\bbest\\b.*\\b(in|of)\\b\",\n                  r\"\\bfree\\b\", r\"\\$\\s?\\d\", r\"\\b\\d+\\s?%\\s?off\\b\", r\"\\baward\", r\"\\bsince\\s+\\d{4}\\b\", r\"\\bcertified\\b\"]\n\ndef validate_hashtags(hashtags, target_customer=None, service=None, platform=\"Instagram\", min_count=None, max_count=None):\n    \"\"\"Return a list of problems (empty list = passed).\n    target_customer and service are accepted so the call matches the project spec, but they are NOT used to reject hashtags.\"\"\"\n    issues = []\n    if not isinstance(hashtags, list):\n        return [\"Hashtags must be returned as a list.\"]\n    lo, hi = HASHTAG_LIMITS.get(platform, (3, 8))\n    lo = lo if min_count is None else min_count\n    hi = hi if max_count is None else max_count\n    if len(hashtags) < lo: issues.append(f\"Too few hashtags ({len(hashtags)}; need at least {lo}).\")\n    if len(hashtags) > hi: issues.append(f\"Too many hashtags ({len(hashtags)}; at most {hi}).\")\n    cleaned = []\n    for tag in hashtags:\n        if not isinstance(tag, str):\n            issues.append(\"A hashtag is not a string.\"); continue\n        tag = tag.strip()\n        if not re.fullmatch(r\"#\\w+\", tag):                    # '#' followed by letters/digits/underscore